<!-- testforalarm.js -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>資料顯示</title>
  <link rel="stylesheet" href="styles.css">
  <!-- 在 head 中引入 Socket.io 客戶端庫 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.1.3/socket.io.js"></script>
  <!-- 引入 jQuery -->
  <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
</head>
<body>
  <h2>Alarm 判斷後的數值 Data</h2>
  <table>
    <thead>
      <tr>
        <th>Value</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody id="alarmTableBody">
      <% alarmData.forEach(item => { %>
        <tr>
          <td><%= item.value %></td>
          <td><%= item.timestamp %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <br>
  <br>
  <br>
  <h2>Lc01 Data</h2>
  <table id="lc01Table">
    <thead>
      <tr>
        <th>Value</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody id="lc01TableBody">
      <% lc01Data.forEach(item => { %>
        <tr>
          <td><%= item.value %></td>
          <td><%= item.timestamp %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <h2>Lc02 Data</h2>
  <table id="lc02Table">
    <thead>
      <tr>
        <th>Value</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody id="lc02TableBody">
      <% lc02Data.forEach(item => { %>
        <tr>
          <td><%= item.value %></td>
          <td><%= item.timestamp %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <br>
  <h2>Lc03 Data</h2>
  <table id="lc03Table">
    <thead>
      <tr>
        <th>Value</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody id="lc03TableBody">
      <% lc03Data.forEach(item => { %>
        <tr>
          <td><%= item.value %></td>
          <td><%= item.timestamp %></td>
        </tr>
      <% }); %>
    </tbody>
    <h2>Lc04 Data</h2>
  <table id="lc04Table">
    <thead>
      <tr>
        <th>Value</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody id="lc04TableBody">
      <% lc03Data.forEach(item => { %>
        <tr>
          <td><%= item.value %></td>
          <td><%= item.timestamp %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<!-- 在 body 底部添加 Socket.io 事件處理程序 -->
<script>
  // 建立 Socket.io 連接
  const socket = io.connect();

  // 定義函數用於更新數據
  function updateData(updatedData, tableId) {
    console.log("Updating data for table:", tableId);

    // 使用 jQuery 更新數據
    $(`#${tableId} tbody`).empty();
    updatedData.forEach(item => {
      $(`#${tableId} tbody`).append(`
        <tr>
          <td>${item.value}</td>
          <td>${item.timestamp}</td>
        </tr>
      `);
    });
  }

  // 監聽 "refreshData" 事件
  socket.on("refreshData", (data) => {
    if (data.tableId === "lc01Table") {
      updateData(data.updatedData, "lc01TableBody");
    } else if (data.tableId === "lc02Table") {
      updateData(data.updatedData, "lc02TableBody");
    } else if (data.tableId === "lc03Table") {
      updateData(data.updatedData, "lc03TableBody");
    } else {
      // Assuming "alarmTable" by default
      updateData(data.updatedData, "alarmTableBody");
    }
  });

  // 設定每 5 秒更新一次
  setInterval(() => {
    socket.emit("refreshData"); // 向伺服器端發送事件
  }, 5000);
</script>

</body>
</html>
