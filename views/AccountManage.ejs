    <div class="R_Main">
        <div class="subNavBar" id="sub_NavBar">
        </div>

        <div class="M_Page">
            <div class="title">
                <h2>【人員管理】</h2>
                <button id="addAccount">新增人員</button>
                <!-- <a href="/account/personalinfo" id="goToPersonalInfo">個人資料</a> -->
            </div>

            <div class="accountManage">
                <table class="" id="accountTable">
                    <thead>
                        <tr>
                            <th class="col_00">No.</th>
                            <th>姓名</th>
                            <th>公司</th>
                            <th>部門</th>
                            <th>權限等級</th>
                            <th>帳號狀態</th>
                            <th>附註</th>
                            <th class="col_last">編輯</th>
                        </tr>
                    </thead>
                </table>
            </div>

            <div class="popUpWindow addEditAccount">
                <h2 class="titlePUW">帳戶帳戶帳戶</h2>

                <div class="infoPUW firstInfo">姓名<label class="infoAccount" id="accName">oxox</label>
                    <input type="text" class="inputAccount accountName" id="inputName">
                </div>
                <div class="infoPUW">公司<label class="infoAccount" id="accCompany">ooxx</label>
                    <img src="../public/images/DropDown_Logo.png" alt="下拉式按鈕圖示" class="dropDown_Logo" id="dDL_accCompany">
                    <div class="accNavBar companyNavBar">
                        <button class="navBarOpt" id="companyNB_01">星佑</button>
                        <button class="navBarOpt" id="companyNB_02">泓德</button>
                        <button class="navBarOpt" id="companyNB_03">星舟</button>
                    </div>
                </div>
                <div class="infoPUW">部門<input type="text" class="inputAccount" id="inputDepartment">
                </div>
                <div class="infoPUW">權限等級<label class="infoAccount" id="accAuthLevel">ooo</label>
                    <img src="../public/images/DropDown_Logo.png" alt="下拉式按鈕圖示" class="dropDown_Logo" id="dDL_accAuthLevel">
                    <div class="accNavBar authLevelNavBar">
                        <button class="navBarOpt" id="authLevelNB_01">管理者</button>
                        <button class="navBarOpt" id="authLevelNB_02">一般用戶</button>
                    </div>
                </div>
                <div class="infoPUW">帳號狀態<label class="infoAccount" id="accStatus">xxx</label>
                    <img src="../public/images/DropDown_Logo.png" alt="下拉式按鈕圖示" class="dropDown_Logo" id="dDL_accStatus">
                    <div class="accNavBar statusNavBar">
                        <button class="navBarOpt" id="statusNB_01">正常</button>
                        <button class="navBarOpt" id="statusNB_02">停用</button>
                        <button class="navBarOpt" id="statusNB_03">刪除</button>
                    </div>
                </div>
                <div class="infoPUW password"><span class="infoName">密碼xox</span><input type="text" class="inputAccount"
                        id="inputPassword">
                </div>
                <label id="id_openBut"></label>

                <button class="closeWindowButton" id="closeWB_Yes">確認</button>
                <button class="closeWindowButton" id="closeWB_No">取消</button>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
        integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
        crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script><!--dataTable-->
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script> <!--dataTable-->
    <script src="../public/scripts/script_template.js"></script>
    <script src="../public/scripts/AccountManage.js"></script>
</body>

</html>