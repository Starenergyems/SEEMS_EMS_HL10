<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!--  default -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--  default -->
    <title>模式控制</title>
    <link href="../public/styles/Login.css" rel="stylesheet" type="text/css" />
    <!--<link href="http://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet" type="text/css" />-->
    <script src="../public/scripts/Login.js" defer></script>
  </head>

  <body>
    <div class="bgStripe bgStripe_1">
      <img src="../public/images/Star_Energy_Logo_v1.png" alt="星佑能源Logo" />
      <!-- /images/Star_Energy_Logo_v1.png -->
    </div>

    <div class="bgStripe bgStripe_2"></div>

    <div class="bgStripe bgStripe_3">
      <div class="loginWindow">
        <h2>EMS管理系統</h2>
        <h3>花蓮E-dReg10MW案</h3>
        <div class="AccPW_Field accountField">
          <img
            src="../public/images/UserAccount_Logo.png"
            alt="使用者帳號Logo"
          />
          <!-- <img src="/images/UserAccount_Logo.png" alt="使用者帳號Logo" /> -->
          <input
            type="text"
            class="AccPW_Input"
            placeholder="Username"
            id="userAccount"
          />
        </div>
        <div class="AccPW_Field passwordField">
          <img src="../public/images/Password_Logo.png" alt="使用者密碼Logo" />
          <input
            type="text"
            class="AccPW_Input"
            placeholder="Password"
            id="userPassword"
          />
        </div>
        <!-- <a id="btn_Login" href="Mode_SysCtrl.ejs">LOG&nbspIN</a> -->
        <a id="btn_Login" href="/mode">LOG&nbspIN</a>
      </div>
    </div>

    <div class="bgStripe bgStripe_4"></div>
    <div class="bgStripe bgStripe_5"></div>

    <script src="../public/scripts/Login.js"></script>
  </body>
</html>
