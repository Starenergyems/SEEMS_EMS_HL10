<%- include('Navbar', { 
    title: '輔電表', 
     stylesheets: [
        '../public/styles/style_template.css',
        '../public/styles/Op_Meter_AuxMeter.css'
    ],
    permission: 'admin',
   
}) %>

    <div class="R_Main">
        <div class="subNavBar" id="sub_NavBar">
            <!-- <h2>模式控制</h2> -->
            <div class="button_sNB default_sNB" id="sNB_01">
                <a href="/operateinfo/singlelinediagram" class="name_button_sNB">單線圖</a>
                <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_sNB_01">
                <div class="ssNavBar">
                    <a href="/operateinfo/singlelinediagram" id="ssNB_01">電力單線圖</a>
                    <a href="/operateinfo/mainmeter" id="ssNB_02">主電表</a>
                    <a href="/operateinfo/auxmeter" class="default_ssNB" id="ssNB_03">輔電表</a>
                </div>
            </div>
            <div class="button_sNB" id="sNB_02">
                <a href="/operateinfo/pcs" class="name_button_sNB">PCS</a>
                <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_sNB_02">
                <div class="ssNavBar">
                    <a href="/operateinfo/pcs/infodetail/1" id="ssNB_01">PCS 1-1</a>
                    <a href="/operateinfo/pcs/infodetail/2" id="ssNB_02">PCS 1-2</a>
                    <a href="/operateinfo/pcs/infodetail/3" id="ssNB_03">PCS 2-1</a>
                    <a href="/operateinfo/pcs/infodetail/4" id="ssNB_04">PCS 2-2</a>
                    <a href="/operateinfo/pcs/infodetail/5" id="ssNB_05">PCS 3-1</a>
                    <a href="/operateinfo/pcs/infodetail/6" id="ssNB_06">PCS 3-2</a>
                    <a href="/operateinfo/pcs/infodetail/7" id="ssNB_07">PCS 4</a>
                </div>
            </div>
            <div class="button_sNB button_sNB_last" id="sNB_03">
                <a href="/operateinfo/battery" class="name_button_sNB">電池</a>
                <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_sNB_03">
                <div class="ssNavBar">
                    <a href="/operateinfo/battery/infodetail/1" id="ssNB_01">BMS 1-1</a>
                    <a href="/operateinfo/battery/infodetail/2" id="ssNB_02">BMS 1-2</a>
                    <a href="/operateinfo/battery/infodetail/3" id="ssNB_03">BMS 2-1</a>
                    <a href="/operateinfo/battery/infodetail/4" id="ssNB_04">BMS 2-2</a>
                    <a href="/operateinfo/battery/infodetail/5" id="ssNB_05">BMS 3-1</a>
                    <a href="/operateinfo/battery/infodetail/6" id="ssNB_06">BMS 3-2</a>
                    <a href="/operateinfo/battery/infodetail/7" id="ssNB_07">BMS 4</a>
                </div>
            </div>
        </div>

        <div class="M_Page">
            <div class="singleLineD">
                <img src="../public/images/SingleLineDiagram_Aux.png" alt="輔電單線圖">
            </div>

            <div class="Meter">
                <table>
                    <tr class="row_01">
                        <td class="col_01"></td>
                        <td class="col_other">高壓盤輔電</td>
                        <td class="col_other">ESS1-1輔電</td>
                        <td class="col_other">ESS2-1輔電</td>
                        <td class="col_other">ESS3-1輔電</td>
                        <td class="col_other">ESS4輔電</td>
                    </tr>
                    <tr class="row_other">
                        <td class="col_01">電壓&nbsp(V)</td>
                        <td class="col_other"><label id="V_Aux_HV"><%=V_Aux_HV%></label></td>
                        <td class="col_other"><label id="V_Aux_ESS1_1"><%=V_Aux_ESS1_1%></label></td>
                        <td class="col_other"><label id="V_Aux_ESS2_1"><%=V_Aux_ESS2_1%></label></td>
                        <td class="col_other"><label id="V_Aux_ESS3_1"><%=V_Aux_ESS3_1%></label></td>
                        <td class="col_other"><label id="V_Aux_ESS4"><%=V_Aux_ESS4%></label></td>
                    </tr>
                    <tr class="row_other">
                        <td class="col_01">電流&nbsp(A)</td>
                        <td class="col_other"><label id="I_Aux_HV"><%=I_Aux_HV%></label></td>
                        <td class="col_other"><label id="I_Aux_ESS1_1"><%=I_Aux_ESS1_1%></label></td>
                        <td class="col_other"><label id="I_Aux_ESS2_1"><%=I_Aux_ESS2_1%></label></td>
                        <td class="col_other"><label id="I_Aux_ESS3_1"><%=I_Aux_ESS3_1%></label></td>
                        <td class="col_other"><label id="I_Aux_ESS4"><%=I_Aux_ESS4%></label></td>
                    </tr>
                    <tr class="row_other">
                        <td class="col_01">功率&nbsp(kW)</td>
                        <td class="col_other"><label id="P_Aux_HV"><%=P_Aux_HV%></label></td>
                        <td class="col_other"><label id="P_Aux_ESS1_1"><%=P_Aux_ESS1_1%></label></td>
                        <td class="col_other"><label id="P_Aux_ESS2_1"><%=P_Aux_ESS2_1%></label></td>
                        <td class="col_other"><label id="P_Aux_ESS3_1"><%=P_Aux_ESS3_1%></label></td>
                        <td class="col_other"><label id="P_Aux_ESS4"><%=P_Aux_ESS4%></label></td>
                    </tr>
                    <tr class="row_other">
                        <td class="col_01">耗能&nbsp(kWh)</td>
                        <td class="col_other"><label id="E_Aux_HV"><%=E_Aux_HV%></label></td>
                        <td class="col_other"><label id="E_Aux_ESS1_1"><%=E_Aux_ESS1_1%></label></td>
                        <td class="col_other"><label id="E_Aux_ESS2_1"><%=E_Aux_ESS2_1%></label></td>
                        <td class="col_other"><label id="E_Aux_ESS3_1"><%=E_Aux_ESS3_1%></label></td>
                        <td class="col_other"><label id="E_Aux_ESS4"><%=E_Aux_ESS4%></label></td>
                    </tr>
                    <tr class="row_06">
                        <td class="col_01"></td>
                        <td class="col_other">案場總輔電</td>
                        <td class="col_other">ESS1-2輔電</td>
                        <td class="col_other">ESS2-2輔電</td>
                        <td class="col_other">ESS3-2輔電</td>
                        <td class="col_other">控制室輔電</td>
                    </tr>
                    <tr class="row_other">
                        <td class="col_01">電壓&nbsp(V)</td>
                        <td class="col_other"><label id="V_Aux_total"><%=V_Aux_total%></label></td>
                        <td class="col_other"><label id="V_Aux_ESS1_2"><%=V_Aux_ESS1_2%></label></td>
                        <td class="col_other"><label id="V_Aux_ESS2_2"><%=V_Aux_ESS2_2%></label></td>
                        <td class="col_other"><label id="V_Aux_ESS3_2"><%=V_Aux_ESS3_2%></label></td>
                        <td class="col_other"><label id="V_Aux_CtrlRoom"><%=V_Aux_CtrlRoom%></label></td>
                    </tr>
                    <tr class="row_other">
                        <td class="col_01">電流&nbsp(A)</td>
                        <td class="col_other"><label id="I_Aux_total"><%=I_Aux_total%></label></td>
                        <td class="col_other"><label id="I_Aux_ESS1_2"><%=I_Aux_ESS1_2%></label></td>
                        <td class="col_other"><label id="I_Aux_ESS2_2"><%=I_Aux_ESS2_2%></label></td>
                        <td class="col_other"><label id="I_Aux_ESS3_2"><%=I_Aux_ESS3_2%></label></td>
                        <td class="col_other"><label id="I_Aux_CtrlRoom"><%=I_Aux_CtrlRoom%></label></td>
                    </tr>
                    <tr class="row_other">
                        <td class="col_01">功率&nbsp(kW)</td>
                        <td class="col_other"><label id="P_Aux_total"><%=P_Aux_total%></label></td>
                        <td class="col_other"><label id="P_Aux_ESS1_2"><%=P_Aux_ESS1_2%></label></td>
                        <td class="col_other"><label id="P_Aux_ESS2_2"><%=P_Aux_ESS2_2%></label></td>
                        <td class="col_other"><label id="P_Aux_ESS3_2"><%=P_Aux_ESS3_2%></label></td>
                        <td class="col_other"><label id="P_Aux_CtrlRoom"><%=P_Aux_CtrlRoom%></label></td>
                    </tr>
                    <tr class="row_other">
                        <td class="col_01">耗能&nbsp(kWh)</td>
                        <td class="col_other"><label id="E_Aux_total"><%=E_Aux_total%></label></td>
                        <td class="col_other"><label id="E_Aux_ESS1_2"><%=E_Aux_ESS1_2%></label></td>
                        <td class="col_other"><label id="E_Aux_ESS2_2"><%=E_Aux_ESS2_2%></label></td>
                        <td class="col_other"><label id="E_Aux_ESS3_2"><%=E_Aux_ESS3_2%></label></td>
                        <td class="col_other"><label id="E_Aux_CtrlRoom"><%=E_Aux_CtrlRoom%></label></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <script src="../public/scripts/script_template.js"></script>
    <script src="../public/scripts/Op_Meter_AuxMeter.js"></script>
</body>

</html>