<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge"> <!--  default -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!--  default -->
    <title>PCS詳細資訊</title>
    <link
      href="../public/styles/style_template.css"
      rel="stylesheet"
      type="text/css"
    />
    <link href="../public/styles/Op_PCS_InfoDetail.css" rel="stylesheet" type="text/css" />
    <!--<link href="http://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet" type="text/css" />-->
</head>

<body>
    <div class="T_Main">
        <img src="../public/images/Star_Energy_Logo.png" alt="星佑能源Logo" id="starEnergy_Logo">
        <h1>花蓮康舒E-dReg10M(地號4-1)</h1>
        <div class="dateTime_Username">
            <label id="dateTime_Now">2000/01/01 23:59:59</label>
            <img src="../public/images/User_Pic.png" alt="使用者圖示" id="user_Logo">
            <label id="userAccount">Administrator</label>
            <div class="accountNavBar">
                <a href="/account/personalinfo" id="accNB_01">個人資料</a>
                <a href="/account/manage" id="accNB_02">人員管理</a>
                <a href="/login" id="accNB_03">登出</a>
            </div>
        </div>
    </div>

    <div class="L_Main">
        <div class="systemStatus">
            <label class="systemMode" id="L_M_systemMode">調頻服務中</label>
            <div class="sumAWNum sumAlarmNum">
                <img src="../public/images/Alarm_Logo.png" alt="Alarm圖示" class="alert_Logo">
                <label class="totalAWNum" id="totalAlarmNum">999</label>
                <img src="../public/images/DropDown_Logo.png" alt="下拉式按鈕圖示" class="dropDown_Logo" id="dD_Logo_sumAlarmNum">
                <div class="sumAW_EachArea sumAlarm_EachArea">
                    <div class="sumAW_Area sumAlarm_Meter">電表<label class="AWNum" id="AlarmNum_Meter">2</label></div>
                    <div class="sumAW_Area sumAlarm_PCS">PCS<label class="AWNum" id="AlarmNum_PCS">1</label></div>
                    <div class="sumAW_Area sumAlarm_Bat">電池<label class="AWNum" id="AlarmNum_Bat">99+</label></div>
                    <div class="sumAW_Area sumAlarm_Env">環境<label class="AWNum" id="AlarmNum_Env">11</label></div>
                    <div class="sumAW_Area sumAlarm_FF">消防<label class="AWNum" id="AlarmNum_FF">54</label></div>
                </div>
            </div>
            <div class="sumAWNum sumWarningNum">
                <img src="../public/images/Warning_Logo.png" alt="Warning圖示" class="alert_Logo">
                <label class="totalAWNum" id="totalWarningNum">52</label>
                <img src="../public/images/DropDown_Logo.png" alt="下拉式按鈕圖示" class="dropDown_Logo" id="dD_Logo_sumWarningNum">
                <div class="sumAW_EachArea sumWarning_EachArea">
                    <div class="sumAW_Area sumWarning_Meter">電表<label class="AWNum" id="WarningNum_Meter">0</label>
                    </div>
                    <div class="sumAW_Area sumWarning_PCS">PCS<label class="AWNum" id="WarningNum_PCS">3</label></div>
                    <div class="sumAW_Area sumWarning_Bat">電池<label class="AWNum" id="WarningNum_Bat">99+</label></div>
                    <div class="sumAW_Area sumWarning_Env">環境<label class="AWNum" id="WarningNum_Env">99</label></div>
                    <div class="sumAW_Area sumWarning_FF">消防<label class="AWNum" id="WarningNum_FF">87</label></div>
                </div>
            </div>
        </div>
        <div class="navBar">
            <a href="/mode"><button class="button_nB" id="nB_Mode">模式控制</button></a>
            <a href="/operateinfo"><button class="button_nB default_nB" id="nB_Operation">運轉資訊</button></a>
            <a href="/systeminfo"><button class="button_nB" id="nB_System">系統資訊</button></a>
            <a href="/alarm"><button class="button_nB" id="nB_Alarm">告警紀錄</button></a>
            <a href="/event"><button class="button_nB" id="nB_Event">事件紀錄</button></a>
            <a href="/report"><button class="button_nB" id="nB_Report">報表</button></a>
            <a href="/chart"><button class="button_nB" id="nB_Chart">即時圖/歷史圖</button></a>
        </div>
        <div class="systemInfo">
            <p class="subTitle">|| 系統資訊 ||</p>

            <div class="DV_Line">頻率<label class="dataValue" id="L_M_freq">60.123</label>
                <p class="dataUnit">Hz</p>
            </div>
            <div class="DV_Line">實功<label class="dataValue" id="L_M_activeP">12345.6</label>
                <p class="dataUnit">kW</p>
            </div>
            <div class="DV_Line">虛功<label class="dataValue" id="L_M_reactiveP">-9876.5</label>
                <p class="dataUnit">kVar</p>
            </div>
            <div class="DV_Line">電壓<label class="dataValue" id="L_M_voltage">23.456</label>
                <p class="dataUnit">kV</p>
            </div>
            <div class="DV_Line">電流<label class="dataValue" id="L_M_current">78.87</label>
                <p class="dataUnit">A</p>
            </div>
            <div class="DV_Line">功因<label class="dataValue" id="L_M_powerFactor">-0.999</label>
                <p class="dataUnit"></p>
            </div>
            <div class="DV_Line">平均SOC<label class="dataValue" id="L_M_avgSOC">87.6</label>
                <p class="dataUnit">%</p>
            </div>
            <div class="DV_Line">最低SOH<label class="dataValue" id="L_M_minSOH">98.7</label>
                <p class="dataUnit">%</p>
            </div>
            <div class="DV_Line">SBSPM<label class="dataValue" id="L_M_SBSPM">98.00</label>
                <p class="dataUnit">%</p>
            </div>

            <div class="DV_Line spareLine">當日充放電量</div>

            <div class="DV_Line">充電<label class="dataValue" id="L_M_chgEtoday">45678.9</label>
                <p class="dataUnit">kWh</p>
            </div>
            <div class="DV_Line lastLine">放電<label class="dataValue" id="L_M_dcgEtoday">56789.0</label>
                <p class="dataUnit">kWh</p>
            </div>
        </div>
        <div class="eStop">
            <img src="../public/images/EPO_Logo.png" alt="緊急停止鈕圖示_Logo" id="epo_Logo">
            <p class="epo_word">緊急停止鈕</p>
        </div>

        <div class="popUpWindow epo">
            <h2 class="titlePUW">緊急停止設定</h2>

            <img src="../public/images/Alarm_Logo_v1.png" alt="Alarm圖示" class="alert_Logo">
            <p class="epoInfo">確認停機</p>

            <button class="closeWindowButton" id="closeWB_Yes">確認</button>
            <button class="closeWindowButton" id="closeWB_No">取消</button>
        </div>
    </div>

    <div class="R_Main">
        <div class="subNavBar" id="sub_NavBar">
            <!-- <h2>模式控制</h2> -->
            <div class="button_sNB" id="sNB_01">
                <a href="/operateinfo/singlelinediagram" class="name_button_sNB">單線圖</a>
                <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_sNB_01">
                <div class="ssNavBar">
                    <a href="/operateinfo/singlelinediagram" id="ssNB_01">電力單線圖</a>
                    <a href="/operateinfo/mainmeter" id="ssNB_02">主電表</a>
                    <a href="/operateinfo/auxmeter" id="ssNB_03">輔電表</a>
                </div>
            </div>
            <div class="button_sNB default_sNB" id="sNB_02">
                <a href="/operateinfo/pcs" class="name_button_sNB">PCS</a>
                <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_sNB_02">
                <div class="ssNavBar">
                    <a href="/operateinfo/pcs/infodetail/1" id="ssNB_01">PCS 1-1</a>
                    <a href="/operateinfo/pcs/infodetail/2" id="ssNB_02">PCS 1-2</a>
                    <a href="/operateinfo/pcs/infodetail/3" id="ssNB_03">PCS 2-1</a>
                    <a href="/operateinfo/pcs/infodetail/4" id="ssNB_04">PCS 2-2</a>
                    <a href="/operateinfo/pcs/infodetail/5" id="ssNB_05">PCS 3-1</a>
                    <a href="/operateinfo/pcs/infodetail/6" id="ssNB_06">PCS 3-2</a>
                    <a href="/operateinfo/pcs/infodetail/7" id="ssNB_07">PCS 4</a>
                </div>
            </div>
            <div class="button_sNB button_sNB_last" id="sNB_03">
                <a href="/operateinfo/battery" class="name_button_sNB">電池</a>
                <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_sNB_03">
                <div class="ssNavBar">
                    <a href="/operateinfo/battery/infodetail/1" id="ssNB_01">BMS 1-1</a>
                    <a href="/operateinfo/battery/infodetail/2" id="ssNB_02">BMS 1-2</a>
                    <a href="/operateinfo/battery/infodetail/3" id="ssNB_03">BMS 2-1</a>
                    <a href="/operateinfo/battery/infodetail/4" id="ssNB_04">BMS 2-2</a>
                    <a href="/operateinfo/battery/infodetail/5" id="ssNB_05">BMS 3-1</a>
                    <a href="/operateinfo/battery/infodetail/6" id="ssNB_06">BMS 3-2</a>
                    <a href="/operateinfo/battery/infodetail/7" id="ssNB_07">BMS 4</a>
                </div>
            </div>
        </div>

        <div class="M_Page">
            <div class="Title">
                <h2>【PCS</h2><label id="No_of_PCS">1-1</label>
                <h2>】</h2>
                <a href="#" class="infoStatus" id="infoPCS">狀態與數值</a>
                <a href="/operateinfo/pcs/alarm" class="infoStatus" id="statusPCS">故障與告警</a>
                <a href="#" class="preNext" id="previousPCS">上一頁</a>
                <a href="#" class="preNext" id="nextPCS">下一頁</a>
            </div>

            <div class="overview">
                <div class="bigInfo bI_workStatus">
                    <p>工作狀態</p>
                    <div class="BG_bigInfo">
                        <div class="subBG_bigInfo"></div>
                        <label class="data_val" id="workStatus">運行</label>
                    </div>
                </div>
                <div class="bigInfo bI_workMode">
                    <p>工作模式</p>
                    <div class="BG_bigInfo">
                        <div class="subBG_bigInfo"></div>
                        <label class="data_val" id="workMode">併網恆功率(AC)</label>
                    </div>
                </div>
                <div class="bigInfo bI_chargeStatus">
                    <p>充放電狀態</p>
                    <div class="BG_bigInfo">
                        <div class="subBG_bigInfo"></div>
                        <label class="data_val" id="chargeStatus">非工作狀態</label>
                    </div>
                </div>
                <div class="bigInfo bI_tot_E_chg">
                    <p>總充電量</p>
                    <div class="BG_bigInfo">
                        <div class="subBG_bigInfo">MWh</div>
                        <label class="data_val" id="tot_E_chg">1234567.8</label>
                    </div>
                </div>
                <div class="bigInfo bI_tot_E_dcg">
                    <p>總放電量</p>
                    <div class="BG_bigInfo">
                        <div class="subBG_bigInfo">MWh</div>
                        <label class="data_val" id="tot_E_dcg">2345678.9</label>
                    </div>
                </div>
            </div>

            <div class="infoBlock outputLimit">
                <h3>輸出限制</h3>
                <div class="DV_Line">最大充電功率<label class="dataValue" id="max_P_chg">3210.0</label>
                    <p class="dataUnit">kW</p>
                </div>
                <div class="DV_Line">最大放電功率<label class="dataValue" id="max_P_dcg">3210.9</label>
                    <p class="dataUnit">kW</p>
                </div>
                <div class="DV_Line">最大感性無功<label class="dataValue" id="max_Q_l">2345.0</label>
                    <p class="dataUnit">kVar</p>
                </div>
                <div class="DV_Line lastLine">最大容性無功<label class="dataValue" id="max_Q_c">2345.6</label>
                    <p class="dataUnit">kVar</p>
                </div>
            </div>

            <div class="heartBeat_leakageCurrent">
                <div class="infoBlock heartBeat">
                    <h3>心跳計數</h3>
                    <img src="../public/images/heartbeat_Logo.png" alt="心電圖圖示">
                    <label class="dataValue" id="HB_Counts">123456</label>
                </div>

                <div class="infoBlock leakageCurrent">
                    <h3>漏電流</h3>
                    <div class="DV_Line lastLine"><label class="dataValue" id="leakage_I">1234.56</label>
                        <p class="dataUnit">A</p>
                    </div>
                </div>
            </div>

            <div class="infoBlock ACside">
                <h3>交流側</h3>
                <div class="columnDVL">
                    <div class="DS_Line">電網狀態<label class="dataStatus" id="gridStatus">併網</label></div>
                    <div class="DV_Line">實功<label class="dataValue" id="activePower">2000.1</label>
                        <p class="dataUnit">kW</p>
                    </div>
                    <div class="DV_Line">虛功<label class="dataValue" id="reactivePower">-1987.6</label>
                        <p class="dataUnit">kVar</p>
                    </div>
                    <div class="DV_Line">功率因數<label class="dataValue" id="powerFactor">0.987</label>
                    </div>
                </div>

                <div class="columnDVL">
                    <div class="DV_Line">RS線電壓<label class="dataValue" id="voltageRS">678.0</label>
                        <p class="dataUnit">V</p>
                    </div>
                    <div class="DV_Line">ST線電壓<label class="dataValue" id="voltageST">654.3</label>
                        <p class="dataUnit">V</p>
                    </div>
                    <div class="DV_Line">TR線電壓<label class="dataValue" id="voltageTR">678.9</label>
                        <p class="dataUnit">V</p>
                    </div>
                </div>

                <div class="columnDVL">
                    <div class="DV_Line">R相電流<label class="dataValue" id="currentR">2100.0</label>
                        <p class="dataUnit">A</p>
                    </div>
                    <div class="DV_Line">S相電流<label class="dataValue" id="currentS">2123.4</label>
                        <p class="dataUnit">A</p>
                    </div>
                    <div class="DV_Line">T相電流<label class="dataValue" id="currentT">2100.9</label>
                        <p class="dataUnit">A</p>
                    </div>
                    <div class="DV_Line lastLine">電網頻率<label class="dataValue" id="gridFreq">60.07</label>
                        <p class="dataUnit">Hz</p>
                    </div>
                </div>
            </div>

            <div class="infoBlock resistanceToGnd">
                <h3>阻抗值</h3>
                <div class="DV_Line">正極對地阻抗<label class="dataValue" id="pElectrodeR">12345.00</label>
                    <p class="dataUnit">kΩ</p>
                </div>
                <div class="DVR_Line">
                    <p class="dataRange">(&nbsp正常範圍&nbsp&#62&nbsp1001.00</p>
                    <p class="dataUnit">kΩ&nbsp)</p>
                </div>
                <div class="DV_Line">負極對地阻抗<label class="dataValue" id="nElectrodeR">12345.67</label>
                    <p class="dataUnit">kΩ</p>
                </div>
                <div class="DVR_Line lastLine">
                    <p class="dataRange">(&nbsp正常範圍&nbsp&#62&nbsp1001.00</p>
                    <p class="dataUnit">kΩ&nbsp)</p>
                </div>
            </div>

            <div class="infoBlock DCside">
                <h3>直流側</h3>
                <div class="DV_Line">直流電壓<label class="dataValue" id="DCvoltage">1543.2</label>
                    <p class="dataUnit">V</p>
                </div>
                <div class="DV_Line">直流電流<label class="dataValue" id="DCcurrent">2501.2</label>
                    <p class="dataUnit">A</p>
                </div>
                <div class="DV_Line lastLine">直流功率<label class="dataValue" id="DCpower">2001.2</label>
                    <p class="dataUnit">kW</p>
                </div>
            </div>

            <div class="infoBlock faultAlarm">
                <h3>故障與告警</h3>
                <div class="DL_Line">整機故障<label class="dataLight RG_L" id="overallFault"></label></div>
                <div class="DL_Line">整機告警<label class="dataLight OG_L" id="overallAlarm"></label></div>
                <div class="DL_Line">故障狀態<label class="dataLight RG_L" id="faultStatus"></label></div>
                <div class="DL_Line lastLine">告警狀態
                    <label class="dataLight OG_L" id="alarmStatus"></label>
                </div>
            </div>

            <div class="infoBlock nodeStatus">
                <h3>節點狀態</h3>
                <div class="DL_Line">交流開關<label class="dataLight RG_L" id="NS_bit_1"></label></div>
                <div class="DL_Line">直流開關<label class="dataLight RG_L" id="NS_bit_2"></label></div>
                <div class="DL_Line">直流熔絲<label class="dataLight RG_L" id="NS_bit_3"></label></div>
                <div class="DL_Line">直流輔助開關1<label class="dataLight RG_L" id="NS_bit_4"></label></div>
                <div class="DL_Line lastLine">直流輔助開關2<label class="dataLight RG_L" id="NS_bit_5"></label>
                </div>
            </div>

            <div class="infoBlock tempPCS">
                <h3>溫度值</h3>
                <div class="DV_Line">機內溫度<label class="dataValue" id="innerTemp">-123.4</label>
                    <p class="dataUnit">&#176C</p>
                </div>
                <div class="DV_Line">模組溫度1<label class="dataValue" id="moduleTemp1">234.5</label>
                    <p class="dataUnit">&#176C</p>
                </div>
                <div class="DV_Line">模組溫度2<label class="dataValue" id="moduleTemp2">45.6</label>
                    <p class="dataUnit">&#176C</p>
                </div>
                <div class="DV_Line">模組溫度3<label class="dataValue" id="moduleTemp3">56.7</label>
                    <p class="dataUnit">&#176C</p>
                </div>
                <div class="DVR_Line lastLine">
                    <p class="dataRange">(&nbsp-10.0&nbsp&#60&nbsp正常範圍&nbsp&#60&nbsp70.0</p>
                    <p class="dataUnit">&#176C&nbsp)</p>
                </div>
            </div>
        </div>
    </div>

    <script src="../public/scripts/script_template.js"></script>
    <script src="../public/scripts/Op_PCS_InfoDetail.js"></script>
</body>

</html>