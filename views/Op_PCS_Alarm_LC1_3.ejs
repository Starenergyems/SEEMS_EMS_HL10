                </div>

                <div class="columnDLL">
                    <div class="DL_Line">電池電壓高<label class="dataLight OG_L <%=Alarm1[9]==='1'?'setToClose':''%>" id="A1_bit_9"></label></div>
                    <div class="DL_Line">電池電壓低<label class="dataLight OG_L <%=Alarm1[10]==='1'?'setToClose':''%>" id="A1_bit_10"></label></div>
                    <div class="DL_Line">直流熔絲異常<label class="dataLight OG_L <%=Alarm1[4]==='1'?'setToClose':''%>" id="A1_bit_4"></label></div>
                    <div class="DL_Line">直流傳感器異常<label class="dataLight OG_L <%=Alarm1[6]==='1'?'setToClose':''%>" id="A1_bit_6"></label></div>
                    <div class="DL_Line">直流防雷器告警<label class="dataLight OG_L <%=Alarm1[7]==='1'?'setToClose':''%>" id="A1_bit_7"></label></div>
