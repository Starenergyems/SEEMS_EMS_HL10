                    <div class="DL_Line">模組保護<label class="dataLight RG_L <%=Fault1[9]==='1'?'setToClose':''%>" id="F1_bit_9"></label></div>
                    <div class="DL_Line">漏電流保護<label class="dataLight RG_L <%=Fault1[13]==='1'?'setToClose':''%>" id="F1_bit_13"></label></div>
                    <div class="DL_Line lastLine">過載保護
                        <label class="dataLight RG_L <%=Fault1[15]==='1'?'setToClose':''%>" id="F1_bit_15"></label>
