                    <div class="DL_Line">機器碼重覆故障<label class="dataLight RG_L <%=Fault2[12]==='1'?'setToClose':''%>" id="F2_bit_12"></label></div>
                    <div class="DL_Line">軟啟動故障<label class="dataLight RG_L <%=Fault2[20]==='1'?'setToClose':''%>" id="F2_bit_20"></label></div>
                    <div class="DL_Line">驅動板故障<label class="dataLight RG_L <%=Fault2[25]==='1'?'setToClose':''%>" id="F2_bit_25"></label></div>
                    <div class="DL_Line">中點電位偏移<label class="dataLight RG_L <%=Fault2[26]==='1'?'setToClose':''%>" id="F2_bit_26"></label></div>
                    <div class="DL_Line gapLine">載波同步故障
                        <label class="dataLight RG_L <%=Fault2[27]==='1'?'setToClose':''%>" id="F2_bit_27"></label>
