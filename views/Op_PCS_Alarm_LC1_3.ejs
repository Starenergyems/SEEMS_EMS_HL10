                    </div>
                    <div class="DL_Line lastLine">BMS通訊異常
                        <label class="dataLight OG_L" id=""></label>
                    </div>
                    <div class="DL_Line lastLine">BMS乾接點
                        <label class="dataLight OG_L" id=""></label>
                    </div>
                </div>

            </div>

            
            <div class="Fault">
                <h3>故障狀態</h3>
