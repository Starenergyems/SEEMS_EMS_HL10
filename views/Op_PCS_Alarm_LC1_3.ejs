                    <div class="DL_Line">模塊過溫<label class="dataLight RG_L <%=Fault1[10]==='1'?'setToClose':''%>" id="F1_bit_10"></label></div>
                    <div class="DL_Line">電抗器過溫<label class="dataLight RG_L <%=Fault1[11]==='1'?'setToClose':''%>" id="F1_bit_11"></label></div>
                    <div class="DL_Line">變壓器過溫<label class="dataLight RG_L <%=Fault1[12]==='1'?'setToClose':''%>" id="F1_bit_12"></label></div>
                    <div class="DL_Line">環溫異常<label class="dataLight RG_L <%=Fault1[23]==='1'?'setToClose':''%>" id="F1_bit_23"></label></div>
