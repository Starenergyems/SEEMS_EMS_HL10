        <div class="M_Page">
            <div class="Title">
                <h2>【PCS</h2><label id="No_of_PCS"><%=No_of_PCS%></label>
                <h2>】</h2>
                <!-- <a href="/operateinfo/pcs/infodetail" class="infoStatus" id="infoPCS">狀態與數值</a>
                <a href="#" class="infoStatus" id="statusPCS">故障與告警</a> -->
                <a href="/operateinfo/pcs/infodetail/<%= pageNumber %>" class="subTitle_unclick">狀態與數值</a>
                <a href="/operateinfo/pcs/alarm/<%= pageNumber %>">故障與告警</a>
                <% if (pageNumber > 1) { %>
                <a href="/operateinfo/pcs/alarm/<%= pageNumber - 1 %>" class="preNext" id="previousPCS">上一頁</a><% } %>
                <% if (pageNumber < 7) { %>
                    <a href="/operateinfo/pcs/alarm/<%= pageNumber + 1 %>" class="preNext" id="nextPCS">下一頁</a><% } %>
            </div>

            <div class="FirstColumn">
                <div class="overview">
                    <div class="bigInfo bI_noOverallFault">
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo">整機故障</div>
                            <label class="data_val" id="noOverallFault"><%=noOverallFault%></label>
                        </div>
                    </div>
                    <div class="bigInfo bI_noOverallAlarm">
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo">整機告警</div>
                            <label class="data_val" id="noOverallAlarm"><%=noOverallAlarm%></label>
                        </div>
                    </div>
                    <div class="bigInfo bI_noFault">
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo">故障狀態</div>
                            <label class="data_val" id="noFault"><%=noFault%></label>
                        </div>
                    </div>
                    <div class="bigInfo bI_noAlarm">
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo">告警狀態</div>
                            <label class="data_val" id="noAlarm"><%=noAlarm%></label>
                        </div>
                    </div>
                </div>

                <div class="overallAlarm">
                    <h3>整機告警狀態</h3>
                    <div class="columnDLL">
                        <div class="DL_Line">心跳停止<label class="dataLight OG_L <%=OA[1]==='1'?'setToClose':''%>" id="OA_bit_1"></label></div>
                        <div class="DL_Line">MV異常<label class="dataLight OG_L <%=OA[2]==='1'?'setToClose':''%>" id="OA_bit_2"></label></div>
                        <div class="DL_Line lastLine">配電供電電源異常
                            <label class="dataLight OG_L <%=OA[10]==='1'?'setToClose':''%>" id="OA_bit_10"></label>
                        </div>
                    </div>
                </div>
    
                <div class="overallFault">
                    <h3>整機故障狀態</h3>
                    <div class="columnDLL">
                        <div class="DL_Line">低壓室門禁保護<label class="dataLight RG_L <%=OF[1]==='1'?'setToClose':''%>" id="OF_bit_1"></label></div>
                        <div class="DL_Line">本地緊急停機<label class="dataLight RG_L <%=OF[2]==='1'?'setToClose':''%>" id="OF_bit_2"></label></div>
                        <div class="DL_Line">遠程緊急停機<label class="dataLight RG_L <%=OF[3]==='1'?'setToClose':''%>" id="OF_bit_3"></label></div>
                        <div class="DL_Line">低壓室煙感<label class="dataLight RG_L <%=OF[5]==='1'?'setToClose':''%>" id="OF_bit_5"></label></div>
                        <div class="DL_Line">主從通訊異常<label class="dataLight RG_L <%=OF[13]==='1'?'setToClose':''%>" id="OF_bit_13"></label></div>
                        <div class="DL_Line lastLine">Goose通訊異常
                            <label class="dataLight RG_L <%=OF[15]==='1'?'setToClose':''%>" id="OF_bit_15"></label>
                        </div>
                    </div>
                </div>
            </div>
            
            
            <div class="Alarm">
                <h3>告警狀態</h3>
                <div class="columnDLL columnDLL_0">
                </div>
                <div class="columnDLL columnDLL_1st">
                    <div class="DL_Line">交流防雷器告警<label class="dataLight OG_L <%=Alarm1[8]==='1'?'setToClose':''%>" id="A1_bit_8"></label></div>
                    <div class="DL_Line">交流開關異常<label class="dataLight OG_L <%=Alarm2[1]==='1'?'setToClose':''%>" id="A2_bit_1"></label></div>
                    <div class="DL_Line">交流主接觸器觸點異常<label class="dataLight OG_L <%=Alarm2[3]==='1'?'setToClose':''%>" id="A2_bit_3"></label>
