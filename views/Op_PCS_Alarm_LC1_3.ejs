                </div>

                <div class="columnDLL">
                    <div class="DL_Line">絕緣阻抗低告警<label class="dataLight OG_L <%=Alarm1[1]==='1'?'setToClose':''%>" id="A1_bit_1"></label></div>
                    <div class="DL_Line">GFRT運行<label class="dataLight OG_L <%=Alarm1[2]==='1'?'setToClose':''%>" id="A1_bit_2"></label></div>
                </div>

                <div class="columnDLL">
                    <div class="DL_Line">溫度異常告警<label class="dataLight OG_L <%=Alarm1[0]==='1'?'setToClose':''%>" id="A1_bit_0"></label></div>
                </div>

                <div class="columnDLL">
                    <div class="DL_Line">風機1異常<label class="dataLight OG_L <%=Alarm1[13]==='1'?'setToClose':''%>" id="A1_bit_13"></label></div>
                    <div class="DL_Line">風機2異常<label class="dataLight OG_L <%=Alarm2[2]==='1'?'setToClose':''%>" id="A2_bit_2"></label></div>
