                    <div class="DL_Line">風機1故障<label class="dataLight RG_L <%=Fault1[17]==='1'?'setToClose':''%>" id="F1_bit_17"></label></div>
                    <div class="DL_Line gapLine">風機2故障
                        <label class="dataLight RG_L <%=Fault2[22]==='1'?'setToClose':''%>" id="F2_bit_22"></label>
                    </div>
                </div>

                <div class="columnDLL">
                    <div class="DL_Line">硬件故障<label class="dataLight RG_L <%=Fault1[24]==='1'?'setToClose':''%>" id="F1_bit_24"></label></div>
                    <div class="DL_Line">絕緣阻抗<label class="dataLight RG_L <%=Fault2[0]==='1'?'setToClose':''%>" id="F2_bit_0"></label></div>
