<%- include('Navbar', { 
    title: '通訊架構圖', 
     stylesheets: [
        '../public/styles/style_template.css',
        '../public/styles/Sys_Comm.css'
    ],
    permission: 'admin'
}) %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge"> <!--  default -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!--  default -->
    <title>通訊架構圖</title>
    <link href="../public/styles/style_template.css" rel="stylesheet" type="text/css" />
    <link href="../public/styles/Sys_Comm.css" rel="stylesheet" type="text/css" />
    <!--<link href="http://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet" type="text/css" />-->
</head>

<body>
    <div class="T_Main">
        <img src="../public/images/Star_Energy_Logo.png" alt="星佑能源Logo" id="starEnergy_Logo">
        <h1>花蓮康舒E-dReg10M(地號4-1)</h1>
        <div class="dateTime_Username">
            <label id="dateTime_Now">2000/01/01 23:59:59</label>
            <img src="../public/images/User_Pic.png" alt="使用者圖示" id="user_Logo">
            <label id="userAccount">Administrator</label>
            <div class="accountNavBar">
                <a href="/account/personalinfo" id="accNB_01">個人資料</a>
                <a href="/account/manage" id="accNB_02">人員管理</a>
                <a href="/login" id="accNB_03">登出</a>
            </div>
        </div>
    </div>

    <div class="L_Main">
        <div class="systemStatus">
            <label class="systemMode" id="L_M_systemMode">調頻服務中</label>
            <div class="sumAWNum sumAlarmNum">
                <img src="../public/images/Alarm_Logo.png" alt="Alarm圖示" class="alert_Logo">
                <label class="totalAWNum" id="totalAlarmNum">999</label>
                <img src="../public/images/DropDown_Logo.png" alt="下拉式按鈕圖示" class="dropDown_Logo" id="dD_Logo_sumAlarmNum">
                <div class="sumAW_EachArea sumAlarm_EachArea">
                    <div class="sumAW_Area sumAlarm_Meter">電表<label class="AWNum" id="AlarmNum_Meter">2</label></div>
                    <div class="sumAW_Area sumAlarm_PCS">PCS<label class="AWNum" id="AlarmNum_PCS">1</label></div>
                    <div class="sumAW_Area sumAlarm_Bat">電池<label class="AWNum" id="AlarmNum_Bat">99+</label></div>
                    <div class="sumAW_Area sumAlarm_Env">環境<label class="AWNum" id="AlarmNum_Env">11</label></div>
                    <div class="sumAW_Area sumAlarm_FF">消防<label class="AWNum" id="AlarmNum_FF">54</label></div>
                </div>
            </div>
            <div class="sumAWNum sumWarningNum">
                <img src="../public/images/Warning_Logo.png" alt="Warning圖示" class="alert_Logo">
                <label class="totalAWNum" id="totalWarningNum">52</label>
                <img src="../public/images/DropDown_Logo.png" alt="下拉式按鈕圖示" class="dropDown_Logo" id="dD_Logo_sumWarningNum">
                <div class="sumAW_EachArea sumWarning_EachArea">
                    <div class="sumAW_Area sumWarning_Meter">電表<label class="AWNum" id="WarningNum_Meter">0</label>
                    </div>
                    <div class="sumAW_Area sumWarning_PCS">PCS<label class="AWNum" id="WarningNum_PCS">3</label></div>
                    <div class="sumAW_Area sumWarning_Bat">電池<label class="AWNum" id="WarningNum_Bat">99+</label></div>
                    <div class="sumAW_Area sumWarning_Env">環境<label class="AWNum" id="WarningNum_Env">99</label></div>
                    <div class="sumAW_Area sumWarning_FF">消防<label class="AWNum" id="WarningNum_FF">87</label></div>
                </div>
            </div>
        </div>
        <div class="navBar">
            <a href="/mode"><button class="button_nB" id="nB_Mode">模式控制</button></a>
            <a href="/operateinfo"><button class="button_nB" id="nB_Operation">運轉資訊</button></a>
            <a href="/systeminfo"><button class="button_nB default_nB" id="nB_System">系統資訊</button></a>
            <a href="/alarm"><button class="button_nB" id="nB_Alarm">告警紀錄</button></a>
            <a href="/event"><button class="button_nB" id="nB_Event">事件紀錄</button></a>
            <a href="/report"><button class="button_nB" id="nB_Report">報表</button></a>
            <a href="/chart"><button class="button_nB" id="nB_Chart">即時圖/歷史圖</button></a>
        </div>
        <div class="systemInfo">
            <p class="subTitle">|| 系統資訊 ||</p>

            <div class="DV_Line">頻率<label class="dataValue" id="L_M_freq">60.123</label>
                <p class="dataUnit">Hz</p>
            </div>
            <div class="DV_Line">實功<label class="dataValue" id="L_M_activeP">12345.6</label>
                <p class="dataUnit">kW</p>
            </div>
            <div class="DV_Line">虛功<label class="dataValue" id="L_M_reactiveP">-9876.5</label>
                <p class="dataUnit">kVar</p>
            </div>
            <div class="DV_Line">電壓<label class="dataValue" id="L_M_voltage">23.456</label>
                <p class="dataUnit">kV</p>
            </div>
            <div class="DV_Line">電流<label class="dataValue" id="L_M_current">78.87</label>
                <p class="dataUnit">A</p>
            </div>
            <div class="DV_Line">功因<label class="dataValue" id="L_M_powerFactor">-0.999</label>
                <p class="dataUnit"></p>
            </div>
            <div class="DV_Line">平均SOC<label class="dataValue" id="L_M_avgSOC">87.6</label>
                <p class="dataUnit">%</p>
            </div>
            <div class="DV_Line">最低SOH<label class="dataValue" id="L_M_minSOH">98.7</label>
                <p class="dataUnit">%</p>
            </div>
            <div class="DV_Line">SBSPM<label class="dataValue" id="L_M_SBSPM">98.00</label>
                <p class="dataUnit">%</p>
            </div>

            <div class="DV_Line spareLine">當日充放電量</div>

            <div class="DV_Line">充電<label class="dataValue" id="L_M_chgEtoday">45678.9</label>
                <p class="dataUnit">kWh</p>
            </div>
            <div class="DV_Line lastLine">放電<label class="dataValue" id="L_M_dcgEtoday">56789.0</label>
                <p class="dataUnit">kWh</p>
            </div>
        </div>
        <div class="eStop">
            <img src="../public/images/EPO_Logo.png" alt="緊急停止鈕圖示_Logo" id="epo_Logo">
            <p class="epo_word">緊急停止鈕</p>
        </div>

        <div class="popUpWindow epo">
            <h2 class="titlePUW">緊急停止設定</h2>

            <img src="../public/images/Alarm_Logo_v1.png" alt="Alarm圖示" class="alert_Logo">
            <p class="epoInfo">確認停機</p>

            <button class="closeWindowButton" id="closeWB_Yes">確認</button>
            <button class="closeWindowButton" id="closeWB_No">取消</button>
        </div>
    </div>

    <div class="R_Main">
        <div class="subNavBar" id="sub_NavBar">
            <!-- <h2>模式控制</h2> -->
            <div class="button_sNB default_sNB" id="sNB_01">
                <a href="/systeminfo/comm" class="name_button_sNB">通訊架構圖</a>
            </div>
            <div class="button_sNB" id="sNB_02">
                <a href="/systeminfo/device" class="name_button_sNB">設備狀態</a>
            </div>
            <div class="button_sNB" id="sNB_03">
                <a href="/systeminfo/environment" class="name_button_sNB">環境監控</a>
            </div>
        </div>

        <div class="M_Page">
            <div class="commArchiD">
                <img src="../public/images/CommArchiDiagram.png" alt="通訊架構圖">
                <!-- <label class="dataLight GB_L" id="EMS_1"></label>
                <label class="dataLight GB_L" id="EMS_2"></label>
                <label class="dataLight GB_L" id="DC"></label>
                <label class="dataLight GB_L" id="HMI"></label> -->
                <label class="dataLight GB_L <%=Comm_GC_1===0?'setToClose':''%>" id="GC_1"></label>
                <label class="dataLight GB_L <%=Comm_GC_2===0?'setToClose':''%>" id="GC_2"></label>
                <label class="dataLight GB_L <%=Comm_HVAC_1===0?'setToClose':''%>" id="HVAC_1"></label>
                <label class="dataLight GB_L <%=Comm_HVAC_2===0?'setToClose':''%>" id="HVAC_2"></label>
                <label class="dataLight GB_L <%=Comm_UPS_EMS===0?'setToClose':''%>" id="UPS_EMS"></label>
                <label class="dataLight GB_L <%=Comm_UPS_CCTV===0?'setToClose':''%>" id="UPS_CCTV"></label>
                <label class="dataLight GB_L <%=Comm_RIO_CtrlRoom===0?'setToClose':''%>" id="RIO_CtrlRoom"></label>
                <label class="dataLight GB_L <%=Comm_FreqMeter===0?'setToClose':''%>" id="FreqMeter"></label>
                <label class="dataLight GB_L <%=Comm_AuxM_MVCB===0?'setToClose':''%>" id="AuxM_MVCB"></label>
                <label class="dataLight GB_L <%=Comm_Relay_MVCB===0?'setToClose':''%>" id="Relay_MVCB"></label>
                <label class="dataLight GB_L <%=Comm_UPS_MVCB===0?'setToClose':''%>" id="UPS_MVCB"></label>
                <label class="dataLight GB_L <%=Comm_Recloser===0?'setToClose':''%>" id="Recloser"></label>
                <label class="dataLight GB_L <%=Comm_RIO_MVCB_1===0?'setToClose':''%>" id="RIO_MVCB_1"></label>
                <label class="dataLight GB_L <%=Comm_RIO_MVCB_2===0?'setToClose':''%>" id="RIO_MVCB_2"></label>
                <label class="dataLight GB_L <%=Comm_TH_MVCB===0?'setToClose':''%>" id="TH_MVCB"></label>
                <label class="dataLight GB_L <%=Comm_Relay_VCB1===0?'setToClose':''%>" id="Relay_VCB1"></label>
                <label class="dataLight GB_L <%=Comm_Relay_VCB2===0?'setToClose':''%>" id="Relay_VCB2"></label>
                <label class="dataLight GB_L <%=Comm_Relay_VCB3===0?'setToClose':''%>" id="Relay_VCB3"></label>
                <label class="dataLight GB_L <%=Comm_Relay_VCB4===0?'setToClose':''%>" id="Relay_VCB4"></label>
                <label class="dataLight GB_L <%=Comm_Relay_VCB_Aux===0?'setToClose':''%>" id="Relay_VCB_Aux"></label>
                <label class="dataLight GB_L <%=Comm_TR_Aux===0?'setToClose':''%>" id="TR_Aux"></label>
                <label class="dataLight GB_L <%=Comm_AuxM_total===0?'setToClose':''%>" id="AuxM_total"></label>
                <label class="dataLight GB_L <%=Comm_AuxM_ESS1_1===0?'setToClose':''%>" id="AuxM_ESS1_1"></label>
                <label class="dataLight GB_L <%=Comm_AuxM_ESS1_2===0?'setToClose':''%>" id="AuxM_ESS1_2"></label>
                <label class="dataLight GB_L <%=Comm_AuxM_ESS2_1===0?'setToClose':''%>" id="AuxM_ESS2_1"></label>
                <label class="dataLight GB_L <%=Comm_AuxM_ESS2_2===0?'setToClose':''%>" id="AuxM_ESS2_2"></label>
                <label class="dataLight GB_L <%=Comm_AuxM_ESS3_1===0?'setToClose':''%>" id="AuxM_ESS3_1"></label>
                <label class="dataLight GB_L <%=Comm_AuxM_ESS3_2===0?'setToClose':''%>" id="AuxM_ESS3_2"></label>
                <label class="dataLight GB_L <%=Comm_AuxM_ESS4===0?'setToClose':''%>" id="AuxM_ESS4"></label>
                <label class="dataLight GB_L <%=Comm_AuxM_CtrlRoom===0?'setToClose':''%>" id="AuxM_CtrlRoom"></label>
                <label class="dataLight GB_L <%=Comm_TR_1===0?'setToClose':''%>" id="TR_1"></label>
                <label class="dataLight GB_L <%=Comm_TR_2===0?'setToClose':''%>" id="TR_2"></label>
                <label class="dataLight GB_L <%=Comm_TR_3===0?'setToClose':''%>" id="TR_3"></label>
                <label class="dataLight GB_L <%=Comm_TR_4===0?'setToClose':''%>" id="TR_4"></label>
                <label class="dataLight GB_L <%=Comm_RIO_ACP_1===0?'setToClose':''%>" id="RIO_ACP_1"></label>
                <label class="dataLight GB_L <%=Comm_RIO_ACP_2===0?'setToClose':''%>" id="RIO_ACP_2"></label>
                <label class="dataLight GB_L <%=Comm_RIO_ACP_3===0?'setToClose':''%>" id="RIO_ACP_3"></label>
                <label class="dataLight GB_L <%=Comm_RIO_ACP_4===0?'setToClose':''%>" id="RIO_ACP_4"></label>
                <label class="dataLight GB_L <%=Comm_UPS_ACP===0?'setToClose':''%>" id="UPS_ACP"></label>
                <label class="dataLight GB_L <%=Comm_LC_1===0?'setToClose':''%>" id="LC_1"></label>
                <label class="dataLight GB_L <%=Comm_LC_2===0?'setToClose':''%>" id="LC_2"></label>
                <label class="dataLight GB_L <%=Comm_LC_3===0?'setToClose':''%>" id="LC_3"></label>
                <label class="dataLight GB_L <%=Comm_LC_4===0?'setToClose':''%>" id="LC_4"></label>
                <label class="dataLight GB_L <%=Comm_PCS1_1===0?'setToClose':''%>" id="PCS1_1"></label>
                <label class="dataLight GB_L <%=Comm_PCS1_2===0?'setToClose':''%>" id="PCS1_2"></label>
                <label class="dataLight GB_L <%=Comm_BMS1_1===0?'setToClose':''%>" id="BMS1_1"></label>
                <label class="dataLight GB_L <%=Comm_BMS1_2===0?'setToClose':''%>" id="BMS1_2"></label>
                <label class="dataLight GB_L <%=Comm_PCS2_1===0?'setToClose':''%>" id="PCS2_1"></label>
                <label class="dataLight GB_L <%=Comm_PCS2_2===0?'setToClose':''%>" id="PCS2_2"></label>
                <label class="dataLight GB_L <%=Comm_BMS2_1===0?'setToClose':''%>" id="BMS2_1"></label>
                <label class="dataLight GB_L <%=Comm_BMS2_2===0?'setToClose':''%>" id="BMS2_2"></label>
                <label class="dataLight GB_L <%=Comm_PCS3_1===0?'setToClose':''%>" id="PCS3_1"></label>
                <label class="dataLight GB_L <%=Comm_PCS3_2===0?'setToClose':''%>" id="PCS3_2"></label>
                <label class="dataLight GB_L <%=Comm_BMS3_1===0?'setToClose':''%>" id="BMS3_1"></label>
                <label class="dataLight GB_L <%=Comm_BMS3_2===0?'setToClose':''%>" id="BMS3_2"></label>
                <label class="dataLight GB_L <%=Comm_PCS4===0?'setToClose':''%>" id="PCS4"></label>
                <label class="dataLight GB_L <%=Comm_BMS4===0?'setToClose':''%>" id="BMS4"></label>

                <div class="device" id="device_TH_MVCB">TH_MVCB<br><%=Comm_GC_1%></div>
                <div class="device" id="device_UPS_ACP">UPS_ACP<br><%=Comm_BMS1_1%></div>
            </div>
        </div>
    </div>

    <script src="../public/scripts/script_template.js"></script>
    <script src="../public/scripts/Sys_Comm.js"></script>
</body>

</html>