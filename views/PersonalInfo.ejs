<%- include('Navbar', { 
    title: '個人資料', 
     stylesheets: [
        'https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css',
        '../public/styles/style_template.css',
        '../public/styles/PersonalInfo.css'
    ],
    permission: 'admin',
   
}) %>

    <div class="R_Main">
        <div class="subNavBar" id="sub_NavBar">
        </div>

        <div class="M_Page">
            <div class="title">
                <h2>【個人資料】</h2>
                <a href="/account/manage" id="goToAccountManage">人員管理</a>
            </div>

            <div class="BG_personalInfo">
                <div class="perInfo_changePW">
                    <table class="personalInfo">
                        <tr class="row_other">
                            <td class="col_01">編號</td>
                            <td class="col_other"><label class="dataValue" id="userNumber"><%= num %></label></td>
                        </tr>
                        <tr class="row_other">
                            <td class="col_01">姓名</td>
                            <td class="col_other"><label class="dataValue" id="userName"><%= name %></label></td>
                        </tr>
                        <tr class="row_other">
                            <td class="col_01">公司</td>
                            <td class="col_other"><label class="dataValue" id="userCompany"><%= company %></label></td>
                        </tr>
                        <tr class="row_other">
                            <td class="col_01">部門</td>
                            <td class="col_other"><label class="dataValue" id="userDepartment"><%= department %></label></td>
                        </tr>
                        <tr class="row_other">
                            <td class="col_01">權限等級</td>
                            <td class="col_other"><label class="dataValue" id="userAuthLevel"><%= permission %></label></td>
                        </tr>
                        <tr class="row_other">
                            <td class="col_01">帳號狀態</td>
                            <td class="col_other"><label class="dataValue" id="userAccStatus"><%= status %></label></td>
                        </tr>
                        <tr class="row_other">
                            <td class="col_01">附註</td>
                            <td class="col_other"><label class="dataValue" id="userNote"><%= note %></label></td>
                        </tr>
                        <tr class="row_other">
                            <td class="col_01">上次登入時間</td>
                            <td class="col_other"><label class="dataValue" id="userLastLoginT"><%= lastlogin %></label></td>
                        </tr>
                    </table>


                    <!-- Tsung Ge version
                         <h3>修改密碼</h3>
                    <table class="changePW">
                        <tr class="row_other">
                            <td class="col_01">舊密碼</td>
                            <td class="col_other"><input type="text" class="input_PW" id="oldPW"></td>
                        </tr>
                        <tr class="row_other">
                            <td class="col_01">新密碼</td>
                            <td class="col_other"><input type="text" class="input_PW" id="newPW"></td>
                        </tr>
                        <tr class="row_other row_confirm">
                            <td class="col_01">確認新密碼</td>
                            <td class="col_other"><input type="text" class="input_PW" id="newPWagain">
                                <button id="changePassword">確認修改</button>
                            </td>
                        </tr>
                    </table> -->

                    <div class="setPasswordBlock">
                        <div class="title">
                            <h3>修改密碼</h3>
                            <button></button>
                        </div>
                        <!-- <form id="changePWform"> -->
                        <table id="changePW">
                            <tbody>
                                <tr>
                                <td class="col_01">舊密碼:</td>
                                <td class="col_other"><input type="text" class="input_PW" id="oldPW" name="oldPW"></td>
                                </tr>
                                <tr>
                                <td class="col_01">新密碼:</td>
                                <td class="col_other"><input type="text" class="input_PW" id="newPW" name="newPW"></td>
                                </tr>
                                <tr>
                                <td class="col_01">確認新密碼:</td>
                                <td class="col_other"><input type="text" class="input_PW" id="newPWagain" name="newPWagain">
                                <button id="changePassword" type="submit" value="確認修改" onclick= "dataPost('/account/personalinfo')">確認修改</button>
                                </td>
                                </tr>
                            </tbody>
                            </table>
                            
                        <!-- </form> -->
                    </div>   

                </div>

                <div class="operationRecord">
                    <h3>操作紀錄</h3>

                    <div class="opRecord">
                        <table class="" id="opRecordTable">
                            <thead>
                                <tr>
                                    <th class="col_00">時間</th>
                                    <th class="col_last">操作內容</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>



        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
        integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
        crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script><!--dataTable-->
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script> <!--dataTable-->
    <script src="../public/scripts/script_template.js"></script>
    <script src="../public/scripts/PersonalInfo.js"></script>

    <script>
        async function dataPost(url) {
                    console.log("POST execute.")
                    document.getElementById('changePassword')
                    const old = document.getElementById("oldPW").value
                    const newa = document.getElementById("newPW").value
                    const newb = document.getElementById("newPWagain").value
                    fetch('/account/personalinfo', {
                        method: 'POST',
                        headers: { 
                        "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.6167.185",
                        'Content-Type': 'application/json' },
                        body: JSON.stringify({"old": old, "newa": newa, "newb": newb}),
                        })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Network response was not ok');
                            }})}
    </script>
</body>
</html>