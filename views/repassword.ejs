
<link href="/public/styles/repassword.css" rel="stylesheet" type="text/css" />            
                    <div class="setPasswordBlock">
                        <div class="title">
                            <h3>修改密碼</h3>
                        </div>
                        <table id="changePW">
                            <tbody>
                                <tr>
                                <td class="col_01">舊密碼:</td>
                                <td class="col_other"><input type="password" class="input_PW" id="oldPW" name="oldPW"></td>
                                </tr>
                                <tr>
                                <td class="col_01">新密碼:</td>
                                <td class="col_other"><input type="password" class="input_PW" id="newPW" name="newPW"></td>
                                </tr>
                                <tr>
                                <td class="col_01">確認新密碼:</td>
                                <td class="col_other"><input type="password" class="input_PW" id="newPWagain" name="newPWagain">
                                <button id="changePassword" type="submit" value="確認修改" >確認修改</button>
                                </td>
                                </tr>
                            </tbody>
                            </table>
                    </div>   
                    <h3>密碼長度介於<%= minTotal %> ~ <%= maxTotal %>位之間</h3>
                    <h3>密碼需含至少<%= minLower %>個小寫、<%= minUpper %>個大寫、<%= minNum %>個數字及<%= minSpe %>個特殊字元!#\$%&()*+,-./:;<=>?@[\]^_{}|~</h3>
                    <!-- <button id="warning" type="button">
                        <span aria-hidden="true">&times;</span>
                        <img src="../public/images/">
                    </button> -->
                </div>
                <script src="../public/scripts/jquery-3.6.0.js"></script>
                <script>
                    document.getElementById("changePassword").addEventListener("click", function() {
                    dataPost('/repassword');
                });
            
                document.addEventListener("keypress", async function(event) {
                    if (event.key === "Enter") {
                        document.getElementById("changePassword").click();
                    }
                });
            
                </script>

    <script>
        async function dataPost(url) {
                    console.log("POST execute.")
                    document.getElementById('changePassword')
                    const old = document.getElementById("oldPW").value
                    const newa = document.getElementById("newPW").value
                    const newb = document.getElementById("newPWagain").value
                    fetch(url, {
                        method: 'POST',
                        headers: { 
                        "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.6167.185",
                        'Content-Type': 'application/json' },
                        body: JSON.stringify({"old": old, "newa": newa, "newb": newb}),
                        })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Network response was not ok');
                            }return response.json();
            }).then(data => {
                if (data["redirect"]) {
                    window.location.href = data["redirect"]
                } 
                else if (data["text"]) {
                    // console.log(data)
                    $("#warning").html(data.text).show(); 
                    // '<strong>警告:</strong> ' 
                    $("#warning").css("visibility", 'visible');
                    // document.getElementById("warning").
                }
        
                
            }).catch(error => {
            console.error('Error:', error);
            })}
    </script>

