<%- include('Navbar', { 
    title: '報表', 
     stylesheets: [
        'https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css',
        '../public/styles/style_template.css',
        '../public/styles/Rpt_Report.css'
    ],
    permission: 'admin'
}) %>

    <div class="R_Main">
        <div class="subNavBar" id="sub_NavBar">
            <!-- <h2>模式控制</h2> -->
            <div class="button_sNB default_sNB" id="sNB_01">
                <a href="/report/report" class="name_button_sNB">報表</a>
            </div>
        </div>

        <div class="M_Page">
            <div class="title">
                <h2>【報表】</h2>
                <button class="clickBut" id="filtNone">總覽</button>
                <div class="filter filtMonthR">
                    <p>月報</p>
                    <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_filtMonthR">
                    <div class="filtOptions">
                        <button class="filtOpt" id="monthRFO_01">月報1</button>
                        <button class="filtOpt" id="monthRFO_02">月報2</button>
                        <button class="filtOpt" id="monthRFO_03">月報3</button>
                    </div>
                </div>
                <div class="filter filtSeasonR">
                    <p>季報</p>
                    <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_filtSeasonR">
                    <div class="filtOptions">
                        <button class="filtOpt" id="seasonRFO_01">季報1</button>
                        <button class="filtOpt" id="seasonRFO_02">季報2</button>
                        <button class="filtOpt" id="seasonRFO_03">季報3</button>
                    </div>
                </div>
                <div class="filter filtYearR">
                    <p>年報</p>
                    <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_filtYearR">
                    <div class="filtOptions">
                        <button class="filtOpt" id="yearRFO_01">年報1</button>
                        <button class="filtOpt" id="yearRFO_02">年報2</button>
                    </div>
                </div>
            </div>

            <div class="report">
                <table class="" id="reportTable">
                    <thead>
                        <tr>
                            <th class="col_00">No.</th>
                            <th>報表類型</th>
                            <th>報表名稱</th>
                            <th class="col_last">下載</th>
                        </tr>
                    </thead>
                </table>






            </div>
        </div>
    </div>


    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
        integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
        crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script><!--dataTable-->
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script> <!--dataTable-->
    <script src="../public/scripts/script_template.js"></script>
    <script src="../public/scripts/Rpt_Report.js"></script>
</body>

</html>