                            <td class="col_03"><label class="cmdIndicator" id="sbyCmdInd"><%=sbyCmdInd%></label><label
                                class="cmdStatus" id="sbyCmdStatus"><%=sbyCmdStatus%></label></td>
                        </tr>
                        <tr class="row_other">
                            <td class="col_01">開始日期時間</td>
                            <td class="col_02"><label class="cmdDateTime" id="exeCmd_StartDT"><%=exeCmd_StartDT%></label></td>
                            <td class="col_03"><label class="cmdDateTime" id="sbyCmd_StartDT"><%=sbyCmd_StartDT%></label></td>
                        </tr>
                        <tr class="row_other">
                            <td class="col_01">結束日期時間</td>
                            <td class="col_02"><label class="cmdDateTime" id="exeCmd_StopDT"><%=exeCmd_StopDT%></label></td>
                            <td class="col_03"><label class="cmdDateTime" id="sbyCmd_StopDT"><%=sbyCmd_StopDT%></label></td>
                        </tr>
                        <tr class="row_other row_last">
                            <td class="col_01">充放電執行量</td>
                            <td class="col_02"><label class="cmd_P" id="exeCmd_P"><%=exeCmd_P%></label><span>kW</span></td>
                            <td class="col_03"><label class="cmd_P" id="sbyCmd_P"><%=sbyCmd_P%></label><span>kW</span></td>
                        </tr>
                    </table>
                </div>
            </div>
    
