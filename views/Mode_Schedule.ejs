        <div class="M_Page">
            <div class="logicCtrl_emerCmd">
                <div class="logicCtrl">
                    <h2>【邏輯功能設定】</h2>
    
                    <div class="DS_Line">使用排程得標量<label class="dataStatus" id="use_P_schd"><%=use_P_schd%></label>
                        <button class="setButton" id="setBut_use_P_schd">Set</button>
                    </div>
                    <div class="DS_Line">使用排程移轉量<label class="dataStatus" id="use_P_LS"><%=use_P_LS%></label>
                        <button class="setButton" id="setBut_use_P_LS">Set</button>
                    </div>
                    <div class="DS_Line">使用排程SOC參考值<label class="dataStatus" id="use_SOC_ref"><%=use_SOC_ref%></label>
                        <button class="setButton" id="setBut_use_SOC_ref">Set</button>
                    </div>
                    <div class="DS_Line">使用移轉量計算SOC理想值<label class="dataStatus" id="autoCal_SOC_ideal"><%=autoCal_SOC_ideal%></label>
                        <button class="setButton" id="setBut_autoCal_SOC_ideal">Set</button>
                    </div>
                    <div class="DS_Line">使用交易平台得標量資料<label class="dataStatus" id="use_MTE_P_96Q"><%=use_MTE_P_96Q%></label>
                        <button class="setButton" id="setBut_use_MTE_P_96Q">Set</button>
                    </div>
                    <div class="DS_Line">使用交易平台移轉量、SOC資料<label class="dataStatus" id="use_MTE_API"><%=use_MTE_API%></label>
                        <button class="setButton" id="setBut_use_MTE_API">Set</button>
                    </div>
                    <div class="DS_Line">使用交易平台頻率移動目標值<label class="dataStatus" id="use_Freq_Cmd"><%=use_Freq_Cmd%></label>
                        <button class="setButton" id="setBut_use_Freq_Cmd">Set</button>
                    </div>
                    <div class="DS_Line">頻率資料來源<label class="dataStatus" id="freqSource"><%=freqSource%></label>
                        <button class="setButton" id="setBut_freqSource">Set</button>
                    </div>
                    <div class="DV_Line">測試用頻率<label class="dataValue" id="Freq_test"><%=Freq_test%></label>
                        <p class="dataUnit">Hz</p>
                    </div>
                </div>
    
                <div class="emergencyCmd">
                    <div class="title">
                        <h2>【緊急調度充放電指令】</h2>
                    </div>
                    <table>
                        <tr class="row_01">
                            <td class="col_01"></td>
                            <td class="col_02">執行指令</td>
                            <td class="col_03">待命指令</td>
                        </tr>
                        <tr class="row_other">
                            <td class="col_01">指令狀態</td>
