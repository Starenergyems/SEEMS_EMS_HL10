    <div class="R_Main">
        <div class="subNavBar" id="sub_NavBar">
            <!-- <h2>模式控制</h2> -->
            <div class="button_sNB" id="sNB_01">
                <a href="/mode/sysctrl" class="name_button_sNB">系統控制</a>
            </div>
            <div class="button_sNB default_sNB" id="sNB_02">
