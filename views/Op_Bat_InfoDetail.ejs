            </div>
            <div class="DV_Line">實功<label class="dataValue" id="L_M_activeP">12345.6</label>
                <p class="dataUnit">kW</p>
            </div>
            <div class="DV_Line">虛功<label class="dataValue" id="L_M_reactiveP">-9876.5</label>
                <p class="dataUnit">kVar</p>
            </div>
            <div class="DV_Line">電壓<label class="dataValue" id="L_M_voltage">23.456</label>
                <p class="dataUnit">kV</p>
            </div>
            <div class="DV_Line">電流<label class="dataValue" id="L_M_current">78.87</label>
                <p class="dataUnit">A</p>
            </div>
            <div class="DV_Line">功因<label class="dataValue" id="L_M_powerFactor">-0.999</label>
                <p class="dataUnit"></p>
            </div>
            <div class="DV_Line">平均SOC<label class="dataValue" id="L_M_avgSOC">87.6</label>
                <p class="dataUnit">%</p>
            </div>
            <div class="DV_Line">最低SOH<label class="dataValue" id="L_M_minSOH">98.7</label>
                <p class="dataUnit">%</p>
            </div>
            <div class="DV_Line">SBSPM<label class="dataValue" id="L_M_SBSPM">98.00</label>
                <p class="dataUnit">%</p>
            </div>

            <div class="DV_Line spareLine">當日充放電量</div>

            <div class="DV_Line">充電<label class="dataValue" id="L_M_chgEtoday">45678.9</label>
                <p class="dataUnit">kWh</p>
            </div>
            <div class="DV_Line lastLine">放電<label class="dataValue" id="L_M_dcgEtoday">56789.0</label>
                <p class="dataUnit">kWh</p>
            </div>
        </div>
        <div class="eStop">
            <img src="../public/images/EPO_Logo.png" alt="緊急停止鈕圖示_Logo" id="epo_Logo">
            <p class="epo_word">緊急停止鈕</p>
        </div>

        <div class="popUpWindow epo">
            <h2 class="titlePUW">緊急停止設定</h2>

            <img src="../public/images/Alarm_Logo_v1.png" alt="Alarm圖示" class="alert_Logo">
            <p class="epoInfo">確認停機</p>

            <button class="closeWindowButton" id="closeWB_Yes">確認</button>
            <button class="closeWindowButton" id="closeWB_No">取消</button>
        </div>
    </div>

    <div class="R_Main">
        <div class="subNavBar" id="sub_NavBar">
            <!-- <h2>模式控制</h2> -->
            <div class="button_sNB" id="sNB_01">
                <a href="/operateinfo/singlelinediagram" class="name_button_sNB">單線圖</a>
                <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_sNB_01">
                <div class="ssNavBar">
                    <a href="/operateinfo/singlelinediagram" id="ssNB_01">電力單線圖</a>
                    <a href="/operateinfo/mainmeter" id="ssNB_02">主電表</a>
                    <a href="/operateinfo/auxmeter" id="ssNB_03">輔電表</a>
                </div>
            </div>
            <div class="button_sNB" id="sNB_02">
                <a href="/operateinfo/pcs" class="name_button_sNB">PCS</a>
                <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_sNB_02">
                <div class="ssNavBar">
                    <a href="/operateinfo/pcs/infodetail/1" id="ssNB_01">PCS 1-1</a>
                    <a href="/operateinfo/pcs/infodetail/2" id="ssNB_02">PCS 1-2</a>
                    <a href="/operateinfo/pcs/infodetail/3" id="ssNB_03">PCS 2-1</a>
                    <a href="/operateinfo/pcs/infodetail/4" id="ssNB_04">PCS 2-2</a>
                    <a href="/operateinfo/pcs/infodetail/5" id="ssNB_05">PCS 3-1</a>
                    <a href="/operateinfo/pcs/infodetail/6" id="ssNB_06">PCS 3-2</a>
                    <a href="/operateinfo/pcs/infodetail/7" id="ssNB_07">PCS 4</a>
                </div>
            </div>
            <div class="button_sNB button_sNB_last default_sNB" id="sNB_03">
                <a href="/operateinfo/battery" class="name_button_sNB">電池</a>
                <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_sNB_03">
                <div class="ssNavBar">
                    <a href="/operateinfo/battery/infodetail/1" id="ssNB_01">BMS 1-1</a>
                    <a href="/operateinfo/battery/infodetail/2" id="ssNB_02">BMS 1-2</a>
                    <a href="/operateinfo/battery/infodetail/3" id="ssNB_03">BMS 2-1</a>
                    <a href="/operateinfo/battery/infodetail/4" id="ssNB_04">BMS 2-2</a>
                    <a href="/operateinfo/battery/infodetail/5" id="ssNB_05">BMS 3-1</a>
                    <a href="/operateinfo/battery/infodetail/6" id="ssNB_06">BMS 3-2</a>
                    <a href="/operateinfo/battery/infodetail/7" id="ssNB_07">BMS 4</a>
                </div>
            </div>
        </div>

        <div class="M_Page">
            <div class="Title">
                <h2>【BMS</h2><label id="No_of_BMS"><%=No_of_BMS%></label>
                <h2>】</h2>
                <a href="#" class="infoStatus" id="infoBMS">狀態與數值</a>
                <a href="/operateinfo/battery/rack" class="infoStatus" id="infoRack">Rack資訊</a>
                <a href="#" class="preNext" id="previousBMS">上一頁</a>
                <a href="#" class="preNext" id="nextBMS">下一頁</a>
            </div>

            <div class="overviewInfo">
                <div class="overview">
                    <div class="bigInfo bI_BMSMode">
                        <p>系統模式</p>
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo"></div>
                            <label class="data_val" id="BMSMode">正常</label>
                        </div>
                    </div>
                    <div class="bigInfo bI_onlineNum">
                        <p>Rack在線數</p>
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo">/&nbsp16</div>
                            <label class="data_val" id="onlineNum">15</label>
                        </div>
                    </div>
                    <div class="bigInfo bI_onlineV">
                        <p>在線電壓</p>
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo">V</div>
                            <label class="data_val" id="onlineV"><%=onlineV%></label>
                        </div>
                    </div>
                    <div class="bigInfo bI_BMSsystemV">
                        <p>系統電壓</p>
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo">V</div>
                            <label class="data_val" id="BMSsystemV"><%=BMSsystemV%></label>
                        </div>
                    </div>
                    <div class="bigInfo bI_BMSsystemI">
                        <p>系統電流</p>
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo">A</div>
                            <label class="data_val" id="BMSsystemI"><%=BMSsystemI%></label>
                        </div>
                    </div>
                    <div class="bigInfo bI_BMSsystemSOC">
                        <p>SOC</p>
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo">%</div>
                            <label class="data_val" id="BMSsystemSOC"><%=BMSsystemSOC%></label>
                        </div>
                    </div>
                    <div class="bigInfo bI_BMSsystemSOH">
                        <p>SOH</p>
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo">%</div>
                            <label class="data_val" id="BMSsystemSOH"><%=BMSsystemSOH%></label>
                        </div>
                    </div>
                    <div class="bigInfo bI_heartBeat">
                        <p>心跳</p>
                        <div class="BG_bigInfo">
                            <div class="subBG_bigInfo"></div>
                            <label class="data_val" id="heartBeat"><%=heartBeat%></label>
                        </div>
                    </div>
                </div>

                <div class="info">
                    <div class="infoBlock rackInfo">
                        <h3>電池機櫃(Rack)</h3>
                        <div class="DV_Line">Rack電壓差<label class="dataValue" id="rackVoltDiff"><%=rackVoltDiff%></label>
                            <p class="dataUnit">V</p>
                        </div>
                        <div class="DP_Line">最高/最低Rack電壓位置<label class="dataP DP_1st" id="rackNoVmax"><%=rackNoVmaxmin.hiByte%></label>
                            <p>/</p>
                            <label class="dataP DP_2nd" id="rackNoVmin"><%=rackNoVmaxmin.loByte%></label>
                        </div>
                        <div class="DV_Line">Rack電流差<label class="dataValue" id="rackCurrDiff"><%=rackCurrDiff%></label>
                            <p class="dataUnit">A</p>
                        </div>
                        <div class="DP_Line">最高/最低Rack電流位置<label class="dataP DP_1st" id="rackNoImax"><%=rackNoImaxmin.hiByte%></label>
                            <p>/</p>
                            <label class="dataP DP_2nd" id="rackNoImin"><%=rackNoImaxmin.loByte%></label>
                        </div>
                        <div class="DV_Line">在線SOC差<label class="dataValue" id="rackSOCDiff"><%=rackSOCDiff%></label>
                            <p class="dataUnit">%</p>
                        </div>
                    </div>

                    <div class="infoBlock cellInfo">
                        <h3>電池電芯(Cell)</h3>
                        <div class="DV_Line">最高電芯電壓<label class="dataValue" id="V_cell_Max"><%=V_cell_Max%></label>
                            <p class="dataUnit">V</p>
                        </div>
                        <div class="DP_Line">位置(R/M/C)<label class="dataP DP_1st" id="rackNoVcMax"><%=rackNoVcMax%></label>
                            <p class="p_1st">/</p><label class="dataP DP_2nd" id="bmuNoVcMax"><%=bmucellNoVcMax.hiByte%></label>
                            <p class="p_2nd">/</p><label class="dataP DP_3rd" id="cellNoVcMax"><%=bmucellNoVcMax.loByte%></label>
                        </div>
                        <div class="DV_Line">最低電芯電壓<label class="dataValue" id="V_cell_Min"><%=V_cell_Min%></label>
                            <p class="dataUnit">V</p>
                        </div>
                        <div class="DP_Line">位置(R/M/C)<label class="dataP DP_1st" id="rackNoVcMin"><%=rackNoVcMin%></label>
                            <p class="p_1st">/</p><label class="dataP DP_2nd" id="bmuNoVcMin"><%=bmucellNoVcMin.hiByte%></label>
                            <p class="p_2nd">/</p><label class="dataP DP_3rd" id="cellNoVcMin"><%=bmucellNoVcMin.loByte%></label>
                        </div>
                        <div class="DV_Line">最大電芯壓差<label class="dataValue" id="V_cell_MaxDiff"><%=V_cell_MaxDiff%></label>
                            <p class="dataUnit">mV</p>
                        </div>

                        <div class="DV_Line">最高電芯溫度<label class="dataValue" id="T_cell_Max"><%=T_cell_Max%></label>
                            <p class="dataUnit">&#176C</p>
                        </div>
                        <div class="DP_Line">位置(R/M/C)<label class="dataP DP_1st" id="rackNoTcMax"><%=rackNoTcMax%></label>
                            <p class="p_1st">/</p><label class="dataP DP_2nd" id="bmuNoTcMax"><%=bmucellNoTcMax.hiByte%></label>
                            <p class="p_2nd">/</p><label class="dataP DP_3rd" id="cellNoTcMax"><%=bmucellNoTcMax.loByte%></label>
                        </div>
                        <div class="DV_Line">最低電芯溫度<label class="dataValue" id="T_cell_Min"><%=T_cell_Min%></label>
                            <p class="dataUnit">&#176C</p>
                        </div>
                        <div class="DP_Line">位置(R/M/C)<label class="dataP DP_1st" id="rackNoTcMin"><%=rackNoTcMin%></label>
                            <p class="p_1st">/</p><label class="dataP DP_2nd" id="bmuNoTcMin"><%=bmucellNoTcMin.hiByte%></label>
                            <p class="p_2nd">/</p><label class="dataP DP_3rd" id="cellNoTcMin"><%=bmucellNoTcMin.loByte%></label>
                        </div>
                        <div class="DV_Line">最大電芯溫差<label class="dataValue" id="T_cell_MaxDiff"><%=T_cell_MaxDiff%></label>
                            <p class="dataUnit">&#176C</p>
                        </div>
                    </div>

                    <div class="infoBlock totalE">
                        <h3>總充放電量</h3>
                        <div class="DV_Line">總充電量<label class="dataValue" id="totalChgE"><%=totalChgE%></label>
                            <p class="dataUnit">MWh</p>
                        </div>
                        <div class="DV_Line lastLine">總放電量<label class="dataValue"
                                id="totalDcgE"><%=totalDcgE%></label>
                            <p class="dataUnit">MWh</p>
                        </div>
                    </div>

                    <div class="infoBlock tempAmbient">
                        <h3>環境溫度</h3>
                        <div class="DV_Line">環境溫度_1<label class="dataValue" id="tempAmb_1"><%=tempAmb_1%></label>
                            <p class="dataUnit">&#176C</p>
                        </div>
                        <div class="DV_Line lastLine">環境溫度_2<label class="dataValue"
                                id="tempAmb_2"><%=tempAmb_2%></label>
                            <p class="dataUnit">&#176C</p>
                        </div>
                    </div>
                </div>

                <div class="FApositionDI">
                    <div class="infoBlock FAposition">
                        <h3>故障告警位置</h3>
                        <div class="DV_Line">CMU告警<label class="dataValue" id="rackNo_alarmCMU"><%=rackNo_alarmCMU%></label>
                            <p class="dataUnit">Rack</p>
                        </div>
                        <div class="DV_Line">CMU故障<label class="dataValue" id="rackNo_faultCMU"><%=rackNo_faultCMU%></label>
                            <p class="dataUnit">Rack</p>
                        </div>
                        <div class="DV_Line">正繼電器故障<label class="dataValue" id="rackNo_faultPRelay"><%=rackNo_faultPRelay%></label>
                            <p class="dataUnit">Rack</p>
                        </div>
                        <div class="DV_Line">負繼電器故障<label class="dataValue" id="rackNo_faultNRelay"><%=rackNo_faultNRelay%></label>
                            <p class="dataUnit">Rack</p>
                        </div>
                        <div class="DV_Line">熔絲故障<label class="dataValue" id="rackNo_faultFuse"><%=rackNo_faultFuse%></label>
                            <p class="dataUnit">Rack</p>
                        </div>
                        <div class="DV_Line">SMU-CMU通訊<label class="dataValue"
                                id="rackNo_commSMUCMU"><%=rackNo_commSMUCMU%></label>
                            <p class="dataUnit">Rack</p>
                        </div>
                    </div>

                    <div class="infoBlock statusDI">
                        <h3>DI狀態</h3>
                        <div class="DL_Line">DI#01狀態<label class="dataLight OG_L <%=statusDI[0]==='1'?'setToClose':''%>" id="statusDI01"></label>
                        </div>
                        <div class="DL_Line">DI#02狀態<label class="dataLight OG_L <%=statusDI[1]==='1'?'setToClose':''%>" id="statusDI02"></label>
                        </div>
                        <div class="DL_Line">DI#03狀態<label class="dataLight OG_L <%=statusDI[2]==='1'?'setToClose':''%>" id="statusDI03"></label>
                        </div>
                        <div class="DL_Line">DI#04狀態<label class="dataLight OG_L <%=statusDI[3]==='1'?'setToClose':''%>" id="statusDI04"></label>
                        </div>
                        <div class="DL_Line">DI#05狀態<label class="dataLight OG_L <%=statusDI[4]==='1'?'setToClose':''%>" id="statusDI05"></label>
                        </div>
                        <div class="DL_Line lastLine">DI#06狀態<label class="dataLight OG_L <%=statusDI[5]==='1'?'setToClose':''%>"
                                id="statusDI06"></label>
                        </div>
                    </div>
                </div>

                <div class="faultHWSMUSOC">
                    <div class="infoBlock faultHW">
                        <h3>硬體故障</h3>
                        <div class="DL_Line">主正繼電器故障<label class="dataLight RG_L <%=faultHW[0]==='1'?'setToClose':''%>" id="faultPRelay"></label>
                        </div>
                        <div class="DL_Line">主負繼電器故障<label class="dataLight RG_L <%=faultHW[1]==='1'?'setToClose':''%>" id="faultNRelay"></label>
                        </div>
                        <div class="DL_Line">主正繼電器閉合失敗<label class="dataLight RG_L <%=faultHW[2]==='1'?'setToClose':''%>"
                                id="closeFailPRelay"></label>
                        </div>
                        <div class="DL_Line">主負繼電器閉合失敗<label class="dataLight RG_L <%=faultHW[3]==='1'?'setToClose':''%>"
                                id="closeFailNRelay"></label>
                        </div>
                        <div class="DL_Line">熔絲斷開<label class="dataLight RG_L <%=faultHW[4]==='1'?'setToClose':''%>" id="blownFuse"></label>
                        </div>
                    </div>

                    <div class="infoBlock faultSMU">
                        <h3>SMU故障</h3>
                        <div class="DL_Line">SMU-CMU通訊<label class="dataLight RG_L <%=faultSMU[0]==='1'?'setToClose':''%>" id="commSMUCMU"></label>
                        </div>
                        <div class="DL_Line">Rack數量保護<label class="dataLight RG_L <%=faultSMU[11]==='1'?'setToClose':''%>" id="rackNoProtect"></label>
                        </div>
                        <div class="DL_Line">系統停止<label class="dataLight RG_L <%=faultSMU[15]==='1'?'setToClose':''%>" id="systemStop"></label>
                        </div>
                    </div>

                    <div class="infoBlock SOCcalibration">
                        <h3>SOC校準</h3>
                        <div class="DL_Line">一級SOC校準提示<label class="dataLight OG_L <%=SOCcali[0]==='1'?'setToClose':''%>" id="1stSOCcal"></label>
                        </div>
                        <div class="DL_Line lastLine">二級SOC校準提示<label class="dataLight OG_L <%=SOCcali[1]==='1'?'setToClose':''%>"
                                id="2ndSOCcal"></label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="infoBlock faultAlarm">
                <h3>CMU故障告警</h3>
                <p class="titleAlarm">告警</p>
