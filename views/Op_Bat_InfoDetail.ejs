                    <div class="sumAW_Area sumWarning_Meter">電表<label class="AWNum" id="WarningNum_Meter">0</label>
                    </div>
                    <div class="sumAW_Area sumWarning_PCS">PCS<label class="AWNum" id="WarningNum_PCS">3</label></div>
                    <div class="sumAW_Area sumWarning_Bat">電池<label class="AWNum" id="WarningNum_Bat">99+</label></div>
                    <div class="sumAW_Area sumWarning_Env">環境<label class="AWNum" id="WarningNum_Env">99</label></div>
                    <div class="sumAW_Area sumWarning_FF">消防<label class="AWNum" id="WarningNum_FF">87</label></div>
                </div>
            </div>
        </div>
        <div class="navBar">
            <a href="/mode"><button class="button_nB" id="nB_Mode">模式控制</button></a>
            <a href="/operateinfo"><button class="button_nB default_nB" id="nB_Operation">運轉資訊</button></a>
            <a href="/systeminfo"><button class="button_nB" id="nB_System">系統資訊</button></a>
            <a href="/alarm"><button class="button_nB" id="nB_Alarm">告警紀錄</button></a>
            <a href="/event"><button class="button_nB" id="nB_Event">事件紀錄</button></a>
            <a href="/report"><button class="button_nB" id="nB_Report">報表</button></a>
            <a href="/chart"><button class="button_nB" id="nB_Chart">即時圖/歷史圖</button></a>
        </div>
        <div class="systemInfo">
