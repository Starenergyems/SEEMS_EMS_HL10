<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Webpage</title>
</head>
<body>
  <h1>Real-time Data Table</h1>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Value</th>
        <th>Edit</th>
      </tr>
    </thead>
    <tbody>
      <% data.forEach(item => { %>
        <tr>
          <td><%= item.name %></td>
          <td><%= item.value %></td>
          <td><button onclick="editValue('<%= item.name %>')">Edit</button></td>
        </tr>
      <% }) %>
      
    </tbody>
  </table>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.0.1/socket.io.js"></script>
  <script>
    const socket = io();

    socket.on("updateValue", (values) => {
      // Clear the table
      const tableBody = document.querySelector('tbody');
      tableBody.innerHTML = '';

      // Iterate through all data and add rows to the table
      values.forEach(item => {
        const newRow = document.createElement("tr");
        newRow.innerHTML = `
          <td>${item.name}</td>
          <td>${item.value}</td>
          <td><button onclick="editValue('${item.name}')">Edit</button></td>
        `;
        tableBody.appendChild(newRow);
      });
    });

    // 新增編輯數值的 JavaScript 函式
    function editValue(name) {
      const newValue = prompt(`Enter new value for ${name}:`);
      if (newValue !== null) {
        // 發送更新請求到伺服器
        socket.emit("editValue", { name, value: newValue });
      }
    }
  </script>
</body>
</html>
