<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>資料顯示</title>
  <link rel="stylesheet" href="styles.css">
  <!-- 在 head 中引入 Socket.io 客戶端庫 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.1.3/socket.io.js"></script>
  <!-- 引入 jQuery -->
  <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
</head>
<body>
  <h2>C4 判斷後的數值 Data</h2>
  <table>
    <thead>
      <tr>
        <th>Value</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody id="c4TableBody">
      <% c4Data.forEach(item => { %>
        <tr>
          <td><%= item.value %></td>
          <td><%= item.timestamp %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <br>
  <br>
  <br>
  <h2>C1 Data</h2>
  <table id="c1Table">
    <thead>
      <tr>
        <th>Value</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody id="c1TableBody">
      <% c1Data.forEach(item => { %>
        <tr>
          <td><%= item.value %></td>
          <td><%= item.timestamp %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <h2>C2 Data</h2>
  <table id="c2Table">
    <thead>
      <tr>
        <th>Value</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody id="c2TableBody">
      <% c2Data.forEach(item => { %>
        <tr>
          <td><%= item.value %></td>
          <td><%= item.timestamp %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <br>
  <h2>C3 Data</h2>
  <table id="c3Table">
    <thead>
      <tr>
        <th>Value</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody id="c3TableBody">
      <% c3Data.forEach(item => { %>
        <tr>
          <td><%= item.value %></td>
          <td><%= item.timestamp %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<!-- 在 body 底部添加 Socket.io 事件處理程序 -->
<script>
  // 建立 Socket.io 連接
  const socket = io.connect();

  // 定義函數用於更新數據
  function updateData(updatedData, tableId) {
    console.log("Updating data for table:", tableId);

    // 使用 jQuery 更新數據
    $(`#${tableId} tbody`).empty();
    updatedData.forEach(item => {
      $(`#${tableId} tbody`).append(`
        <tr>
          <td>${item.value}</td>
          <td>${item.timestamp}</td>
        </tr>
      `);
    });
  }

  // 監聽 "refreshData" 事件
  socket.on("refreshData", (data) => {
    if (data.tableId === "c1Table") {
      updateData(data.updatedData, "c1TableBody");
    } else if (data.tableId === "c2Table") {
      updateData(data.updatedData, "c2TableBody");
    } else if (data.tableId === "c3Table") {
      updateData(data.updatedData, "c3TableBody");
    } else {
      // Assuming "c4Table" by default
      updateData(data.updatedData, "c4TableBody");
    }
  });

  // 設定每 5 秒更新一次
  setInterval(() => {
    socket.emit("refreshData"); // 向伺服器端發送事件
  }, 5000);
</script>

</body>
</html>
