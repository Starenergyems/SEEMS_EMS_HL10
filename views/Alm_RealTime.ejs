<%- include('Navbar', { 
    title: '即時告警', 
     stylesheets: [
        'https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css',
        '../public/styles/style_template.css',
        '../public/styles/Alm_RealTime.css'
    ],
    permission: 'admin'
}) %>

    <div class="R_Main">
        <div class="subNavBar" id="sub_NavBar">
            <!-- <h2>模式控制</h2> -->
            <div class="button_sNB default_sNB" id="sNB_01">
                <a href="/alarm/realtime" class="name_button_sNB">即時告警</a>
            </div>
            <div class="button_sNB" id="sNB_02">
                <a href="/alarm/history" class="name_button_sNB">歷史告警</a>
            </div>
        </div>

        <div class="M_Page">
            <div class="title">
                <h2>【即時告警】</h2>
                <button class="clickBut" id="filtNone">總覽</button>
                <div class="filter filtDevice">
                    <p>設備</p>
                    <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_filtDevice">
                    <div class="filtOptions">
                        <button class="filtOpt" id="deviceFO_01">控制室</button>
                        <button class="filtOpt" id="deviceFO_02">電腦主機</button>
                        <button class="filtOpt" id="deviceFO_03">保護電驛</button>
                        <button class="filtOpt" id="deviceFO_04">GC</button>
                        <button class="filtOpt" id="deviceFO_05">自動復閉器</button>
                        <button class="filtOpt" id="deviceFO_06">電表</button>
                        <button class="filtOpt" id="deviceFO_07">UPS</button>
                        <button class="filtOpt" id="deviceFO_08">HVAC</button>
                    </div>
                </div>
                <div class="filter filtLocation">
                    <p>地點</p>
                    <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_filtLocation">
                    <div class="filtOptions">
                        <button class="filtOpt" id="locationFO_01">控制室</button>
                        <button class="filtOpt" id="locationFO_02">MVCB</button>
                        <button class="filtOpt" id="locationFO_03">VCB-1</button>
                        <button class="filtOpt" id="locationFO_04">VCB-2</button>
                        <button class="filtOpt" id="locationFO_05">VCB-3</button>
                        <button class="filtOpt" id="locationFO_06">VCB-4</button>
                        <button class="filtOpt" id="locationFO_07">ACP-1</button>
                        <button class="filtOpt" id="locationFO_08">ACP-2</button>
                        <button class="filtOpt" id="locationFO_09">ACP-3</button>
                        <button class="filtOpt" id="locationFO_10">ACP-4</button>
                    </div>
                </div>
                <div class="filter filtLevel">
                    <p>等級</p>
                    <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_filtLevel">
                    <div class="filtOptions">
                        <button class="filtOpt" id="levelFO_01">警告</button>
                        <button class="filtOpt" id="levelFO_02">錯誤</button>
                    </div>
                </div>
            </div>

            <div class="almRealTime">
                <table class="" id="almTable">
                    <thead>
                        <tr>
                            <th class="col_00">No.</th>
                            <th>時間</th>
                            <th>地點</th>
                            <th>設備名稱</th>
                            <th>等級</th>
                            <th>告警內容</th>
                            <th>已讀&nbsp<input type="checkbox" id="chb_AckAll" style=" display: inline-block; height: 18px;width: 18px;"></th>
                            <th>復歸</th>
                            <th class="col_last">復歸時間</th>
                        </tr>
                    </thead>
                </table>
            </div>

            <div class="popUpWindow dataStatus_Set" id="message">
                <h2 class="titlePUW">提示</h2>
                <p class="check_tip">是否確定勾選所有告警?</p>

                <button class="closeWindowButton" id="closeWB_Yes" onclick="allCheck()">確認</button>
                <button class="closeWindowButton" id="closeWB_No" onclick="remove()">取消</button>
            </div>
        </div>
    </div>


    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
        integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
        crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script><!--dataTable-->
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script> <!--dataTable-->
    <script src="../public/scripts/script_template.js"></script>
    <script src="../public/scripts/Alm_RealTime.js"></script>
</body>

</html>