<%- include('Navbar', { 
    title: '操作紀錄', 
     stylesheets: [
        'https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css',
        '../public/styles/style_template.css',
        '../public/styles/Evt_Operation.css'
    ],
    permission: 'admin'
}) %>

    <div class="R_Main">
        <div class="subNavBar" id="sub_NavBar">
            <!-- <h2>模式控制</h2> -->
            <div class="button_sNB default_sNB" id="sNB_01">
                <a href="/event/operation" class="name_button_sNB">操作紀錄</a>
            </div>
            <div class="button_sNB" id="sNB_02">
                <a href="/event/door" class="name_button_sNB">門禁紀錄</a>
            </div>
        </div>

        <div class="M_Page">
            <div class="title">
                <h2>【操作紀錄】</h2>
                <button class="clickBut" id="filtNone">總覽</button>
                <div class="filter filtOpType">
                    <p>操作類別</p>
                    <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_filtOpType">
                    <div class="filtOptions">
                        <button class="filtOpt" id="opTypeFO_01">登入登出</button>
                        <button class="filtOpt" id="opTypeFO_02">設備控制</button>
                        <button class="filtOpt" id="opTypeFO_03">系統模式</button>
                        <button class="filtOpt" id="opTypeFO_04">保護邏輯</button>
                        <button class="filtOpt" id="opTypeFO_05">其它</button>
                    </div>
                </div>
                <div class="filter filtDevice">
                    <p>設備</p>
                    <img src="../public/images/DropDown_Logo_v1.png" alt="下拉式選單圖示_v1" id="dDL_filtDevice">
                    <div class="filtOptions">
                        <button class="filtOpt" id="deviceFO_01">控制室</button>
                        <button class="filtOpt" id="deviceFO_02">電腦主機</button>
                        <button class="filtOpt" id="deviceFO_03">保護電驛</button>
                        <button class="filtOpt" id="deviceFO_04">GC</button>
                        <button class="filtOpt" id="deviceFO_05">自動復閉器</button>
                        <button class="filtOpt" id="deviceFO_06">電表</button>
                        <button class="filtOpt" id="deviceFO_07">UPS</button>
                        <button class="filtOpt" id="deviceFO_08">HVAC</button>
                    </div>
                </div>

                <div class="space_div"></div>

                <div class="timeRangeQuery">
                    <p>時間區間查詢</p>
                    <div class="setStartEnd">
                        <div class="setStartTime">開始時間
                            <img src="../public/images/GoToFirst.png" alt="移至第一個時間段" id="goToFirst_dS"><img
                                src="../public/images/GoToPrevious.png" alt="移至上一個時間段" id="goToPrevious_dS">
                            <input type="date" id="dateStart"><input type="time" step="1" id="timeStart">
                            <img src="../public/images/GoToNext.png" alt="移至下一個時間段" id="goToNext_dS"><img src="../public/images/GoToLast.png"
                                alt="移至最後一個時間段" id="goToLast_dS">
                        </div>
                        <div class="setEndTime">結束時間
                            <img src="../public/images/GoToFirst.png" alt="移至第一個時間段" id="goToFirst_dE"><img
                                src="../public/images/GoToPrevious.png" alt="移至上一個時間段" id="goToPrevious_dE">
                            <input type="date" id="dateEnd"><input type="time" step="1" id="timeEnd">
                            <img src="../public/images/GoToNext.png" alt="移至下一個時間段" id="goToNext_dE"><img src="../public/images/GoToLast.png"
                                alt="移至最後一個時間段" id="goToLast_dE">
                        </div>
                    </div>
                    <button id="btn_Query">查詢</button>
                </div>
            </div>

            <div class="evtOperation">
                <table class="" id="evtTable">
                    <thead>
                        <tr>
                            <th class="col_00">No.</th>
                            <th>操作類別</th>
                            <th>設備名稱</th>
                            <th>操作時間</th>
                            <th>操作者</th>
                            <th class="col_last">操作內容</th>
                        </tr>
                    </thead>
                </table>





            </div>

            <div class="popUpWindow alert_WrongDataSet">
                <p>有誤！</p>
                <button class="closeWindowButton" id="closeWB_No">取消</button>
            </div>

            <div class="block_temp">
                <button class="btn_test" id="btn_test_01">測試01</button>
                <button class="btn_test" id="btn_test_02">測試02</button>
                <button class="btn_test" id="btn_test_03">測試03</button>
                <button class="btn_test" id="btn_test_04">測試04</button><br>

                <input type="date" id="Startdate" max="9999-12-31">
                <input type="time" step="1" id="Starttime"><br>
                <input type="date" id="Enddate">
                <input type="time" step="1" id="Endtime">
            </div>
        </div>
    </div>


    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
        integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
        crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script><!--dataTable-->
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script> <!--dataTable-->
    <script src="../public/scripts/script_template.js"></script>
    <script src="../public/scripts/Evt_Operation.js"></script>
</body>

</html>