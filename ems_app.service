[Unit]
Description=EMS Node.js Watchdog Service
After=network.target

[Service]
ExecStart=/usr/bin/node app.js
WorkingDirectory=/path/to/your/app
StandardOutput=file:/path/to/your/app/outlog.log
StandardError=file:/path/to/your/app/errlog.log
Restart=always
User=your_username

# Additional options for more graceful restarts
RestartSec=3s  # Set a restart delay
StartLimitInterval=60s  # Set the interval in which StartLimitBurst is valid
StartLimitBurst=18  # Allow restarts within the specified interval

KillSignal=SIGTERM

# Specify how to gracefully stop the service
# ExecStop=/usr/bin/node /path/to/your/app/stop-script.js

[Install]
WantedBy=multi-user.target
